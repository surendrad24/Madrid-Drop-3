{% liquid
  assign packaging_image = section.settings.packaging_image
  assign handcrafted_image = section.settings.handcrafted_image
  assign fine_image = section.settings.fine_image
  assign production_video = section.settings.production_video
%}

<style>
  .ph-product-story-{{ section.id }} {
    background: #fff;
    color: #050505;
    font-family: 'PhoriaRegular', var(--font-body-family);
    letter-spacing: 0;
  }

  .ph-product-story-{{ section.id }} .ph-product-story__media {
    display: block;
    width: 100%;
  }

  .ph-product-story-{{ section.id }} .ph-product-story__media img,
  .ph-product-story-{{ section.id }} .ph-product-story__media video {
    display: block;
    width: 100%;
    height: auto;
  }

  .ph-product-story-{{ section.id }} .ph-product-story__production-video {
    aspect-ratio: 430 / 538;
    background: #111;
    object-fit: cover;
  }

  .ph-product-story-{{ section.id }} .ph-product-story__copy {
    padding: 36px 20px 43px;
  }

  .ph-product-story-{{ section.id }} .ph-product-story__copy--right {
    text-align: right;
  }

  .ph-product-story-{{ section.id }} .ph-product-story__copy--paper {
    background: #f6f6f6 url({{ 'ph-product-story-paper.webp' | asset_url }}) center / cover no-repeat;
    min-height: 280px;
    padding: 38px 26px 44px;
    text-align: right;
  }

  .ph-product-story-{{ section.id }} .ph-product-story__copy--fine {
    padding: 35px 22px 34px;
  }

  .ph-product-story-{{ section.id }} .ph-product-story__eyebrow,
  .ph-product-story-{{ section.id }} .ph-product-story__title {
    margin: 0;
    font-family: 'PhoriaBold', var(--font-heading-family);
    font-size: 13px;
    letter-spacing: 0.46em;
    line-height: 2.25;
    text-transform: uppercase;
  }

  .ph-product-story-{{ section.id }} .ph-product-story__title {
    margin-bottom: 30px;
  }

  .ph-product-story-{{ section.id }} .ph-product-story__copy--fine .ph-product-story__eyebrow,
  .ph-product-story-{{ section.id }} .ph-product-story__copy--fine .ph-product-story__title {
    font-size: 13px;
    letter-spacing: 0.52em;
    line-height: 1.72;
  }

  .ph-product-story-{{ section.id }} .ph-product-story__copy--fine .ph-product-story__title {
    margin-bottom: 25px;
  }

  .ph-product-story-{{ section.id }} .ph-product-story__fine-hallmarks {
    display: block;
    width: 92px;
    height: auto;
    margin: 0 0 34px;
  }

  .ph-product-story-{{ section.id }} .ph-product-story__body {
    margin: 0;
    color: #a6a6a6;
    font-size: 7px;
    letter-spacing: 0.46em;
    line-height: 3.15;
    text-transform: uppercase;
  }

  .ph-product-story-{{ section.id }} .ph-product-story__body p {
    margin: 0 0 22px;
  }

  .ph-product-story-{{ section.id }} .ph-product-story__body p:last-child {
    margin-bottom: 0;
  }

  .ph-product-story-{{ section.id }} .ph-product-story__copy--fine .ph-product-story__body {
    color: #050505;
    font-size: 6.5px;
    letter-spacing: 0.52em;
    line-height: 3.45;
  }

  .ph-product-story-{{ section.id }} .ph-product-story__copy--fine .ph-product-story__body p {
    margin-bottom: 24px;
  }

  .ph-product-story-{{ section.id }} .ph-product-story__body strong,
  .ph-product-story-{{ section.id }} .ph-product-story__body b {
    color: #050505;
    font-family: 'PhoriaBold', var(--font-heading-family);
    font-weight: 400;
  }

  .ph-product-story-{{ section.id }} .ph-product-story__price-label {
    display: block;
    margin-top: 30px;
    font-family: 'PhoriaBold', var(--font-heading-family);
    font-size: 8px;
    letter-spacing: 0.48em;
    line-height: 2.3;
    text-transform: uppercase;
  }

  .ph-product-story-{{ section.id }} .ph-product-story__price {
    display: block;
    margin-top: 2px;
    font-family: 'PhoriaBold', var(--font-heading-family);
    font-size: 12px;
    letter-spacing: 0.32em;
    line-height: 1.8;
    text-transform: uppercase;
  }

  .ph-product-story-{{ section.id }} .ph-product-story__copy--fine .ph-product-story__price-label {
    margin-top: 28px;
    font-size: 7px;
    letter-spacing: 0.52em;
    line-height: 1.9;
  }

  .ph-product-story-{{ section.id }} .ph-product-story__copy--fine .ph-product-story__price {
    margin-top: 4px;
    font-size: 10px;
    letter-spacing: 0.44em;
    line-height: 1.4;
  }

  .ph-product-story-{{ section.id }} .ph-product-story__button {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 45px;
    margin-top: 31px;
    background: #111;
    color: #fff;
    font-family: 'PhoriaBold', var(--font-heading-family);
    font-size: 8px;
    letter-spacing: 0.5em;
    line-height: 1;
    text-decoration: none;
    text-transform: uppercase;
  }

  .ph-product-story-{{ section.id }} .ph-product-story__copy--fine .ph-product-story__button {
    min-height: 41px;
    margin-top: 51px;
    font-size: 7px;
    letter-spacing: 0.52em;
  }

  @media screen and (min-width: 750px) {
    .ph-product-story-{{ section.id }} {
      max-width: 860px;
      margin: 0 auto;
    }

    .ph-product-story-{{ section.id }} .ph-product-story__copy {
      padding: 56px 40px 68px;
    }

    .ph-product-story-{{ section.id }} .ph-product-story__copy--fine {
      padding: 66px 42px 64px;
    }

    .ph-product-story-{{ section.id }} .ph-product-story__copy--paper {
      min-height: 410px;
      padding: 72px 56px 78px;
    }

    .ph-product-story-{{ section.id }} .ph-product-story__eyebrow,
    .ph-product-story-{{ section.id }} .ph-product-story__title {
      font-size: 18px;
    }

    .ph-product-story-{{ section.id }} .ph-product-story__body {
      font-size: 9px;
      line-height: 3.1;
    }

    .ph-product-story-{{ section.id }} .ph-product-story__button {
      max-width: 390px;
    }

    .ph-product-story-{{ section.id }} .ph-product-story__fine-hallmarks {
      width: 112px;
    }
  }
</style>

<section class="ph-product-story ph-product-story-{{ section.id }}">
  <div class="ph-product-story__media">
    {% if packaging_image != blank %}
      {{ packaging_image | image_url: width: 1200 | image_tag: loading: 'lazy', widths: '430, 860, 1200', sizes: '(max-width: 749px) 100vw, 860px', alt: section.settings.packaging_alt }}
    {% else %}
      <img src="{{ 'ph-product-story-packaging.webp' | asset_url }}" alt="{{ section.settings.packaging_alt | escape }}" loading="lazy" width="860" height="866">
    {% endif %}
  </div>

  <div class="ph-product-story__copy">
    <p class="ph-product-story__eyebrow">{{ section.settings.packaging_eyebrow }}</p>
    <h2 class="ph-product-story__title">{{ section.settings.packaging_title }}</h2>
    <div class="ph-product-story__body">{{ section.settings.packaging_copy }}</div>
  </div>

  <div class="ph-product-story__copy ph-product-story__copy--paper">
    <p class="ph-product-story__eyebrow">{{ section.settings.handcrafted_eyebrow }}</p>
    <h2 class="ph-product-story__title">{{ section.settings.handcrafted_title }}</h2>
    <div class="ph-product-story__body">{{ section.settings.handcrafted_copy }}</div>
  </div>

  <div class="ph-product-story__media">
    {% if handcrafted_image != blank %}
      {{ handcrafted_image | image_url: width: 1200 | image_tag: loading: 'lazy', widths: '430, 860, 1200', sizes: '(max-width: 749px) 100vw, 860px', alt: section.settings.handcrafted_alt }}
    {% else %}
      <img src="{{ 'ph-product-story-handcrafted.webp' | asset_url }}" alt="{{ section.settings.handcrafted_alt | escape }}" loading="lazy" width="860" height="946">
    {% endif %}
  </div>

  <div class="ph-product-story__media">
    {% if fine_image != blank %}
      {{ fine_image | image_url: width: 1200 | image_tag: loading: 'lazy', widths: '430, 860, 1200', sizes: '(max-width: 749px) 100vw, 860px', alt: section.settings.fine_alt }}
    {% else %}
      <img src="{{ 'ph-product-story-fine.webp' | asset_url }}" alt="{{ section.settings.fine_alt | escape }}" loading="lazy" width="860" height="1074">
    {% endif %}
  </div>

  <div class="ph-product-story__copy ph-product-story__copy--fine">
    <p class="ph-product-story__eyebrow">{{ section.settings.fine_eyebrow }}</p>
    <h2 class="ph-product-story__title">{{ section.settings.fine_title }}</h2>
    <img
      class="ph-product-story__fine-hallmarks"
      src="{{ 'ph-product-story-fine-hallmarks.png' | asset_url }}"
      alt=""
      loading="lazy"
      width="320"
      height="46"
    >
    <div class="ph-product-story__body">{{ section.settings.fine_copy }}</div>
    <span class="ph-product-story__price-label">{{ section.settings.fine_price_label }}</span>
    <span class="ph-product-story__price">{{ section.settings.fine_price }}</span>
    {% if section.settings.fine_button_label != blank %}
      <a class="ph-product-story__button" href="{{ section.settings.fine_button_link | default: '/pages/contact' }}">{{ section.settings.fine_button_label }}</a>
    {% endif %}
  </div>
</section>

{% schema %}
{
  "name": "Ph Product Story",
  "settings": [
    {
      "type": "image_picker",
      "id": "packaging_image",
      "label": "Packaging image"
    },
    {
      "type": "text",
      "id": "packaging_alt",
      "label": "Packaging image alt",
      "default": "Phoria packaging"
    },
    {
      "type": "text",
      "id": "packaging_eyebrow",
      "label": "Packaging eyebrow",
      "default": "All Packaging,"
    },
    {
      "type": "text",
      "id": "packaging_title",
      "label": "Packaging title",
      "default": "Considered"
    },
    {
      "type": "richtext",
      "id": "packaging_copy",
      "label": "Packaging copy",
      "default": "<p>Every Phoria order comes with a reusable airtight storage box and satin travel pouch intended to be kept to store your Phoria piece or any other pieces in your jewellery collection.</p><p>You’ll also receive a care guide and free polishing cloth to help look after for your piece.</p>"
    },
    {
      "type": "image_picker",
      "id": "handcrafted_image",
      "label": "Handcrafted image after copy"
    },
    {
      "type": "video",
      "id": "production_video",
      "label": "Production video"
    },
    {
      "type": "text",
      "id": "handcrafted_alt",
      "label": "Handcrafted image alt",
      "default": "Jewellery handcrafting process"
    },
    {
      "type": "text",
      "id": "handcrafted_eyebrow",
      "label": "Handcrafted eyebrow",
      "default": "Every Piece,"
    },
    {
      "type": "text",
      "id": "handcrafted_title",
      "label": "Handcrafted title",
      "default": "Handcrafted"
    },
    {
      "type": "richtext",
      "id": "handcrafted_copy",
      "label": "Handcrafted copy",
      "default": "<p>Quality is at the heart of Phoria. Every piece is handcrafted by skilled artisans using 100% recycled 925 sterling silver, recycled 18ct gold and ethically sourced, fully traceable natural gemstones.</p><p>Our partner studio is part of the Responsible Jewellery Council, sharing our commitment to responsible sourcing, exceptional craftsmanship and jewellery designed to last.</p>"
    },
    {
      "type": "image_picker",
      "id": "fine_image",
      "label": "Phoria Fine image"
    },
    {
      "type": "text",
      "id": "fine_alt",
      "label": "Phoria Fine image alt",
      "default": "Phoria Fine jewellery"
    },
    {
      "type": "text",
      "id": "fine_eyebrow",
      "label": "Fine eyebrow",
      "default": "Reimagined in"
    },
    {
      "type": "text",
      "id": "fine_title",
      "label": "Fine title",
      "default": "Phoria Fine"
    },
    {
      "type": "richtext",
      "id": "fine_copy",
      "label": "Fine copy",
      "default": "<p>This Phoria design can be commissioned in any precious metal, any carat or any gemstone of your choice.</p><p>Every Phoria Fine piece is made to order, individually crafted to your specifications and ready within four weeks. Enquire to begin creating your piece.</p>"
    },
    {
      "type": "text",
      "id": "fine_price_label",
      "label": "Fine price label",
      "default": "Estimated starting price from:"
    },
    {
      "type": "text",
      "id": "fine_price",
      "label": "Fine price",
      "default": "£5,640"
    },
    {
      "type": "text",
      "id": "fine_button_label",
      "label": "Fine button label",
      "default": "Make an Enquiry"
    },
    {
      "type": "url",
      "id": "fine_button_link",
      "label": "Fine button link"
    }
  ],
  "presets": [
    {
      "name": "Ph Product Story"
    }
  ]
}
{% endschema %}
