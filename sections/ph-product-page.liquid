<script>
document.addEventListener('DOMContentLoaded', function() {
  if (typeof Motion !== 'undefined') {
    const { animate, inView, transform } = Motion;
    
    const productContainer = document.querySelector('.ph-pdp-product-container');
    if (productContainer) {
      inView(productContainer, (elem) => {
        animate(elem, 
          { opacity: [0, 1], y: [20, 0] }, 
          { duration: 0.8, easing: "ease-out" }
        );
      }, { once: true });
    }
    
    const productTitle = document.querySelector('.ph-pdp-product-title');
    if (productTitle) {
      inView(productTitle, (elem) => {
        animate(elem, 
          { opacity: [0, 1], y: [20, 0] }, 
          { duration: 0.6, delay: 0.2, easing: "ease-out" }
        );
      }, { once: true });
    }
    
    const descriptionWrapper = document.querySelector('.ph-pdp-product-description-wrapper');
    if (descriptionWrapper) {
      inView(descriptionWrapper, (elem) => {
        animate(elem, 
          { opacity: [0, 1], y: [20, 0] }, 
          { duration: 0.6, delay: 0.4, easing: "ease-out" }
        );
      }, { once: true });
    }
    
    const productDetailsAnimate = document.querySelector('.ph-pdp-product-details--animate');
    if (productDetailsAnimate) {
      inView(productDetailsAnimate, (elem) => {
        animate(elem, 
          { opacity: [0, 1], y: [20, 0] }, 
          { duration: 0.6, delay: 0.6, easing: "ease-out" }
        );
      }, { once: true });
    }
  }
  
  const variants = [
    {% for variant in product.variants %}
      {
        id: {{ variant.id }},
        title: {{ variant.title | json }},
        options: {{ variant.options | json }},
        option1: {{ variant.option1 | json }},
        option2: {{ variant.option2 | json }},
        option3: {{ variant.option3 | json }},
        price: {{ variant.price | json }},
        compare_at_price: {{ variant.compare_at_price | default: 0 | json }},
        available: {{ variant.available | json }},
        inventory_quantity: {{ variant.inventory_quantity | json }},
        varient_specific_title: {{ variant.metafields.custom.varient_specific_title.value | default: variant.metafields.custom.varient_specific_title | default: "" | json }},
        varient_specific_extrainfo: {{ variant.metafields.custom.varient_specific_extrainfo.value | default: variant.metafields.custom.varient_specific_extrainfo | default: "" | json }},
        varient_specific_description: {{ variant.metafields.custom.varient_specific_description.value | default: variant.metafields.custom.varient_specific_description | default: "" | json }},
        varient_specific_fitnote: {{ variant.metafields.custom.varient_specific_fitnote.value | default: variant.metafields.custom.varient_specific_fitnote | default: "" | json }}
      }{% unless forloop.last %},{% endunless %}
    {% endfor %}
  ];
  const mainProductOptionNames = {{ product.options | json }};
  const defaultProductTitle = {{ product.title | json }};
  const defaultProductInfo = {{ product.metafields.custom.product_information | default: product.metafields.custom.extra_info | default: '' | strip | json }};
  const defaultProductDescription = {{ product.description | default: '' | json }};
  const defaultProductFitNotes = {{ product.metafields.custom.fit_notes.value | default: product.metafields.custom.fit_notes | default: '' | json }};
  const variantTitleRulesRaw = {{ product.metafields.custom.varient_title_rules.value | default: product.metafields.custom.varient_title_rules | json }};
  const variantExtraInfoRulesRaw = {{ product.metafields.custom.varient_extrainfo_rules.value | default: product.metafields.custom.varient_extrainfo_rules | json }};
  const variantDescriptionRulesRaw = {{ product.metafields.custom.varient_description_rules.value | default: product.metafields.custom.varient_description_rules | json }};
  const variantMatchRulesRaw = {{ product.metafields.custom.varient_match_rules.value | default: product.metafields.custom.varient_match_rules | json }};
  const variantSpecificContentEnabled = {{ lc_enabled_mode | json }};

  function normalizeBundleOptionGroup(optionName) {
    const normalized = String(optionName || '').trim().toLowerCase();
    if (!normalized) return '';
    if (normalized.includes('size') || normalized.includes('denomination') || normalized === 'price') return 'size';
    if (normalized.includes('stone') || normalized.includes('color') || normalized.includes('cut')) return 'stone';
    if (
      normalized.includes('plating') ||
      normalized.includes('material') ||
      normalized.includes('metal') ||
      normalized.includes('finish')
    ) return 'finish';
    return normalized;
  }

  function getCurrentMainOptionSelectionMap() {
    const selectedMap = {};
    (mainProductOptionNames || []).forEach((optionName, index) => {
      const value = getOptionInputValue(index);
      const group = normalizeBundleOptionGroup(optionName);
      if (group && value) selectedMap[group] = value;
    });
    return selectedMap;
  }

  function getVariantOptionsArray(variant, optionCount) {
    if (Array.isArray(variant?.options) && variant.options.length) return variant.options;
    return [variant?.option1, variant?.option2, variant?.option3].slice(0, optionCount);
  }

  function resolveBundleVariantForProductData(productData, selectedSize, preferredSelections = {}) {
    if (!productData || !Array.isArray(productData.variants) || !selectedSize) return null;

    const optionNames = Array.isArray(productData.options) ? productData.options : [];
    const optionCount = optionNames.length || 3;
    const desiredByIndex = {};
    let sizeIndex = -1;

    optionNames.forEach((optionName, index) => {
      const group = normalizeBundleOptionGroup(optionName);
      if (group === 'size') {
        sizeIndex = index;
        desiredByIndex[index] = selectedSize;
        return;
      }
      if (preferredSelections[group]) {
        desiredByIndex[index] = preferredSelections[group];
      }
    });

    if (sizeIndex === -1) {
      sizeIndex = 0;
      desiredByIndex[0] = selectedSize;
    }

    const strictMatch = productData.variants.find((variant) => {
      const options = getVariantOptionsArray(variant, optionCount);
      return Object.entries(desiredByIndex).every(([index, value]) => options[Number(index)] === value);
    });

    if (strictMatch) return strictMatch;

    return productData.variants.find((variant) => {
      const options = getVariantOptionsArray(variant, optionCount);
      return options[sizeIndex] === selectedSize;
    }) || null;
  }

  window.__phResolveBundleVariant = resolveBundleVariantForProductData;
  window.__phGetMainOptionSelections = getCurrentMainOptionSelectionMap;

  function parseVariantRules(rawRules) {
    if (!rawRules) return null;
    if (typeof rawRules === 'string') {
      const trimmed = rawRules.trim();
      if (!trimmed) return null;
      try {
        return JSON.parse(trimmed);
      } catch (error) {
        return null;
      }
    }
    return rawRules;
  }

  function normalizeRuleToken(value) {
    return String(value || '').trim().toLowerCase();
  }

  function getVariantMatchPool(selectedVariant) {
    const optionValues = Array.isArray(selectedVariant?.options) ? selectedVariant.options : [];
    const normalizedOptions = optionValues.map(normalizeRuleToken).filter(Boolean);
    const normalizedTitle = normalizeRuleToken(selectedVariant?.title || '');
    return { normalizedOptions, normalizedTitle };
  }

  function matchesToken(token, matchPool) {
    const normalizedToken = normalizeRuleToken(token);
    if (!normalizedToken) return false;

    if (matchPool.normalizedOptions.includes(normalizedToken)) {
      return true;
    }

    return matchPool.normalizedTitle.includes(normalizedToken);
  }

  function keyMatchesVariant(ruleKey, matchPool) {
    if (!ruleKey) return false;
    const parts = String(ruleKey).split(/[|,]/).map((part) => part.trim()).filter(Boolean);
    if (!parts.length) return false;
    return parts.some((part) => matchesToken(part, matchPool));
  }

  function resolveRuleValue(rawRules, selectedVariant) {
    const parsedRules = parseVariantRules(rawRules);
    if (!selectedVariant) return '';
    if (!parsedRules) {
      if (typeof rawRules === 'string' && rawRules.trim()) {
        return rawRules.trim();
      }
      return '';
    }

    const matchPool = getVariantMatchPool(selectedVariant);

    if (Array.isArray(parsedRules)) {
      for (const rule of parsedRules) {
        if (!rule || typeof rule !== 'object') continue;

        const candidateTokens = [];
        if (Array.isArray(rule.variants)) candidateTokens.push(...rule.variants);
        if (Array.isArray(rule.sizes)) candidateTokens.push(...rule.sizes);
        if (Array.isArray(rule.options)) candidateTokens.push(...rule.options);
        if (Array.isArray(rule.values)) candidateTokens.push(...rule.values);
        if (typeof rule.variant === 'string') candidateTokens.push(rule.variant);
        if (typeof rule.size === 'string') candidateTokens.push(rule.size);
        if (typeof rule.option === 'string') candidateTokens.push(rule.option);
        if (typeof rule.key === 'string') candidateTokens.push(rule.key);
        if (typeof rule.match === 'string') candidateTokens.push(rule.match);

        const hasMatch = candidateTokens.some((token) => matchesToken(token, matchPool));
        if (!hasMatch) continue;

        const resolvedValue = rule.value ?? rule.title ?? rule.info ?? rule.text ?? rule.description ?? '';
        if (typeof resolvedValue === 'string' && resolvedValue.trim()) {
          return resolvedValue.trim();
        }
      }
      return '';
    }

    if (typeof parsedRules === 'object') {
      const normalizedDefault = typeof parsedRules.default === 'string' ? parsedRules.default.trim() : '';
      for (const [key, value] of Object.entries(parsedRules)) {
        if (key === 'default') continue;
        if (!keyMatchesVariant(key, matchPool)) continue;
        if (typeof value === 'string' && value.trim()) {
          return value.trim();
        }
      }
      return normalizedDefault;
    }

    return '';
  }

  function parseMatchTokens(rawRules) {
    const parsed = parseVariantRules(rawRules);

    if (Array.isArray(parsed)) {
      return parsed.map((entry) => String(entry || '').trim()).filter(Boolean);
    }

    if (parsed && typeof parsed === 'object') {
      const tokens = [];
      if (Array.isArray(parsed.variants)) tokens.push(...parsed.variants);
      if (Array.isArray(parsed.sizes)) tokens.push(...parsed.sizes);
      if (Array.isArray(parsed.options)) tokens.push(...parsed.options);
      if (Array.isArray(parsed.values)) tokens.push(...parsed.values);
      if (typeof parsed.variant === 'string') tokens.push(parsed.variant);
      if (typeof parsed.size === 'string') tokens.push(parsed.size);
      if (typeof parsed.option === 'string') tokens.push(parsed.option);
      if (typeof parsed.key === 'string') tokens.push(parsed.key);
      if (typeof parsed.match === 'string') tokens.push(parsed.match);
      return tokens.map((entry) => String(entry || '').trim()).filter(Boolean);
    }

    if (typeof rawRules === 'string' && rawRules.trim()) {
      return rawRules
        .split(/[,\n|]/)
        .map((entry) => entry.trim())
        .filter(Boolean);
    }

    return [];
  }

  function hasStructuredRuleObject(rawRules) {
    const parsed = parseVariantRules(rawRules);
    return !!parsed && (Array.isArray(parsed) || typeof parsed === 'object');
  }

  function variantMatchesTokens(selectedVariant, tokens) {
    if (!selectedVariant || !tokens.length) return false;
    const matchPool = getVariantMatchPool(selectedVariant);
    return tokens.some((token) => matchesToken(token, matchPool));
  }

  function setTextForSelectors(selector, value) {
    if (typeof value !== 'string') return;
    document.querySelectorAll(selector).forEach((element) => {
      element.textContent = value;
    });
  }

  function setSubtitleForSelectors(selector, value) {
    const text = typeof value === 'string' ? value.trim() : '';
    document.querySelectorAll(selector).forEach((element) => {
      element.textContent = text;
      element.style.display = text ? '' : 'none';
    });
  }

  function splitDescriptionByReadMore(htmlContent) {
    const raw = String(htmlContent || '').replace(/\r\n/g, '\n');
    const hasHtmlTags = /<[a-z][\s\S]*>/i.test(raw);
    const html = hasHtmlTags
      ? raw
      : raw
          .split(/\n{2,}/)
          .map((part) => part.trim())
          .filter(Boolean)
          .map((part) => `<p>${part.replace(/\n/g, '<br>')}</p>`)
          .join('');

    const full = html
      .replace(/<p>\s*<!--more-->\s*<\/p>/gi, '')
      .replace(/<!--more-->/gi, '');

    if (/<p>\s*<!--more-->\s*<\/p>|<!--more-->/i.test(html)) {
      const parts = html.split(/<p>\s*<!--more-->\s*<\/p>|<!--more-->/i);
      return { truncated: parts[0] || '', full };
    }

    const paragraphBoundary = full.split(/<\/p>\s*<p>/i);
    if (paragraphBoundary.length > 1) {
      const truncated = `${paragraphBoundary[0]}</p>`;
      return { truncated, full };
    }

    return { truncated: full, full };
  }

  function bindDescriptionReadMore(button, descriptionWrapper, description) {
    if (button.dataset.readMoreBound === 'true') return;
    button.dataset.readMoreBound = 'true';

    button.addEventListener('click', function () {
      const isExpanded = button.textContent.includes('LESS');
      const startHeight = descriptionWrapper.offsetHeight;

      if (isExpanded) {
        description.innerHTML = description.getAttribute('data-truncated') || '';
        button.textContent = 'READ MORE';
      } else {
        description.innerHTML = description.getAttribute('data-full') || '';
        button.textContent = 'READ LESS';
      }

      const targetHeight = description.offsetHeight + button.offsetHeight + 60;
      descriptionWrapper.style.height = startHeight + 'px';
      void descriptionWrapper.offsetHeight;
      descriptionWrapper.style.height = targetHeight + 'px';
    });
  }

  function applyVariantDescription(descriptionHtml) {
    const descriptionWrapper = document.querySelector('.ph-pdp-product-description-wrapper');
    const description = descriptionWrapper ? descriptionWrapper.querySelector('.ph-pdp-product-description') : null;
    const button = descriptionWrapper ? descriptionWrapper.querySelector('.ph-pdp-read-more') : null;
    if (!descriptionWrapper || !description || !button) return;

    const { truncated, full } = splitDescriptionByReadMore(descriptionHtml);
    const normalizedTruncated = (truncated || '').trim();
    const normalizedFull = (full || '').trim();
    const hasMoreContent = normalizedTruncated && normalizedFull && normalizedTruncated !== normalizedFull;

    description.setAttribute('data-truncated', truncated || '');
    description.setAttribute('data-full', full || '');
    description.innerHTML = truncated || full || '';

    if (hasMoreContent) {
      button.style.display = '';
      button.textContent = 'READ MORE';
      bindDescriptionReadMore(button, descriptionWrapper, description);
    } else {
      button.style.display = 'none';
    }

    const initialHeight = description.offsetHeight + (hasMoreContent ? button.offsetHeight : 0) + 60;
    descriptionWrapper.style.height = initialHeight + 'px';
  }

  function getFitNotesContentElement() {
    const accordionSections = document.querySelectorAll('.ph-pdp-accordion-section');
    for (const section of accordionSections) {
      const titleEl = section.querySelector('.ph-pdp-accordion-title');
      const contentEl = section.querySelector('.ph-pdp-accordion-content');
      if (!titleEl || !contentEl) continue;
      const normalizedTitle = String(titleEl.textContent || '').trim().toLowerCase();
      if (normalizedTitle === 'fit notes') return contentEl;
    }
    return null;
  }

  const fitNotesContentElement = getFitNotesContentElement();
  const defaultFitNotesHtmlFromBlock = fitNotesContentElement ? fitNotesContentElement.innerHTML : '';

  function escapeHtml(text) {
    return String(text || '')
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;')
      .replace(/'/g, '&#39;');
  }

  function richTextNodeToHtml(node) {
    if (!node || typeof node !== 'object') return '';
    const type = String(node.type || '').toLowerCase();

    if (type === 'text') {
      let content = escapeHtml(node.value || '');
      if (node.bold) content = `<strong class="ph-fitnote-strong">${content}</strong>`;
      if (node.italic) content = `<em>${content}</em>`;
      return content;
    }

    const childrenHtml = Array.isArray(node.children)
      ? node.children.map(richTextNodeToHtml).join('')
      : '';

    if (type === 'paragraph') return `<p>${childrenHtml}</p>`;
    if (type === 'root') return childrenHtml;
    return childrenHtml;
  }

  function normalizeFitNoteToHtml(rawValue) {
    if (rawValue === null || rawValue === undefined) return '';
    if (typeof rawValue === 'object') {
      return richTextNodeToHtml(rawValue).trim();
    }

    const text = String(rawValue || '').trim();
    if (!text) return '';

    if ((text.startsWith('{') && text.endsWith('}')) || (text.startsWith('[') && text.endsWith(']'))) {
      try {
        const parsed = JSON.parse(text);
        if (parsed && typeof parsed === 'object') {
          return richTextNodeToHtml(parsed).trim();
        }
      } catch (error) {
      }
    }

    if (/<[a-z][\s\S]*>/i.test(text)) return text;
    return `<p>${escapeHtml(text)}</p>`;
  }

  function applyVariantFitNotes(selectedVariant, forceDefault = false) {
    if (!fitNotesContentElement) return;
    if (!variantSpecificContentEnabled && !forceDefault) {
      const defaultFitNoteText = normalizeFitNoteToHtml(defaultProductFitNotes);
      fitNotesContentElement.innerHTML = defaultFitNoteText || defaultFitNotesHtmlFromBlock;
      return;
    }
    const variantSpecificFitNote = normalizeFitNoteToHtml(selectedVariant?.varient_specific_fitnote);
    const defaultFitNoteText = normalizeFitNoteToHtml(defaultProductFitNotes);
    const nextFitNote = forceDefault
      ? (defaultFitNoteText || defaultFitNotesHtmlFromBlock)
      : (variantSpecificFitNote || defaultFitNoteText || defaultFitNotesHtmlFromBlock);
    fitNotesContentElement.innerHTML = nextFitNote;
  }

  function getForcedWaistChainLetterTitle(letterValue) {
    if (!isChainSourceProduct) return '';
    const letter = String(letterValue || '').trim().toUpperCase();
    if (!/^[A-Z]$/.test(letter)) return '';
    return `"THE ${letter}" I.D. WAIST CHAIN`;
  }

  function applyVariantTitleInfoRules(selectedVariant) {
    if (!variantSpecificContentEnabled) {
      setTextForSelectors('.ph-pdp-product-title', defaultProductTitle);
      setTextForSelectors('.ph-sticky-pdp-product-title', defaultProductTitle);
      setSubtitleForSelectors('.ph-pdp-product-subtitle', defaultProductInfo);
      setSubtitleForSelectors('.ph-sticky-pdp-product-subtitle', defaultProductInfo);
      applyVariantDescription(defaultProductDescription);
      applyVariantFitNotes(selectedVariant, true);
      return;
    }

    const fallbackSmallSizeTokens = ['UK E', 'UK F', 'UK G'];
    const configuredMatchTokens = parseMatchTokens(variantMatchRulesRaw);
    const plainStringMatchTokens = configuredMatchTokens.length ? configuredMatchTokens : fallbackSmallSizeTokens;

    const titleUsesStructuredRules = hasStructuredRuleObject(variantTitleRulesRaw);
    const infoUsesStructuredRules = hasStructuredRuleObject(variantExtraInfoRulesRaw);
    const descriptionUsesStructuredRules = hasStructuredRuleObject(variantDescriptionRulesRaw);
    const shouldApplyPlainStringRules = variantMatchesTokens(selectedVariant, plainStringMatchTokens);

    let titleOverride = resolveRuleValue(variantTitleRulesRaw, selectedVariant);
    let infoOverride = resolveRuleValue(variantExtraInfoRulesRaw, selectedVariant);
    let descriptionOverride = resolveRuleValue(variantDescriptionRulesRaw, selectedVariant);

    if (!titleUsesStructuredRules && !shouldApplyPlainStringRules) {
      titleOverride = '';
    }

    if (!infoUsesStructuredRules && !shouldApplyPlainStringRules) {
      infoOverride = '';
    }

    if (!descriptionUsesStructuredRules && !shouldApplyPlainStringRules) {
      descriptionOverride = '';
    }

    const variantSpecificTitle = String(selectedVariant?.varient_specific_title || '').trim();
    const variantSpecificInfo = String(selectedVariant?.varient_specific_extrainfo || '').trim();
    const variantSpecificDescription = String(selectedVariant?.varient_specific_description || '').trim();

    const nextTitle = variantSpecificTitle || titleOverride || defaultProductTitle;
    const nextInfo = variantSpecificInfo || infoOverride || defaultProductInfo;
    const nextDescription = variantSpecificDescription || descriptionOverride || defaultProductDescription;

    setTextForSelectors('.ph-pdp-product-title', nextTitle);
    setTextForSelectors('.ph-sticky-pdp-product-title', nextTitle);

    setSubtitleForSelectors('.ph-pdp-product-subtitle', nextInfo);
    setSubtitleForSelectors('.ph-sticky-pdp-product-subtitle', nextInfo);

    applyVariantDescription(nextDescription);
    applyVariantFitNotes(selectedVariant);
  }
  
  function getOptionInputValue(optionIndex) {
    const input = document.querySelector(`input[id="Option${optionIndex}"]`);
    return input ? input.value : '';
  }

  function setOptionInputValue(optionIndex, value) {
    document.querySelectorAll(`input[id="Option${optionIndex}"]`).forEach((input) => {
      input.value = value;
    });
  }

  function syncOptionUiFromVariant(variant) {
    if (!variant || !Array.isArray(variant.options)) return;

    variant.options.forEach((value, optionIndex) => {
      setOptionInputValue(optionIndex, value);
      document.querySelectorAll(`[data-option-index="${optionIndex}"]`).forEach((group) => {
        group.querySelectorAll('.ph-pdp-variant-box, .ph-pdp-size-box, .ph-pdp-text-option').forEach((el) => {
          el.classList.toggle('selected', el.getAttribute('data-option-value') === value);
        });
      });
    });
  }

  function getBundleGroupValueFromMainSelection(group) {
    const selectedMap = getCurrentMainOptionSelectionMap();
    return selectedMap[group] || '';
  }

  function applyPreservedOptionsFromUrl() {
    const url = new URL(window.location.href);
    let hasPreservedSelection = false;

    const optionCount = Array.isArray(variants?.[0]?.options) ? variants[0].options.length : 0;
    for (let index = 0; index < optionCount; index += 1) {
      const paramKey = `ph_o${index}`;
      const preservedValue = url.searchParams.get(paramKey);
      if (!preservedValue) continue;

      const optionValueExists = variants.some((variant) => variant.options[index] === preservedValue);
      if (!optionValueExists) {
        url.searchParams.delete(paramKey);
        continue;
      }

      setOptionInputValue(index, preservedValue);
      hasPreservedSelection = true;
      url.searchParams.delete(paramKey);
    }

    const semanticParams = {
      size: url.searchParams.get('ph_size') || '',
      stone: url.searchParams.get('ph_stone') || '',
      finish: url.searchParams.get('ph_finish') || ''
    };

    (mainProductOptionNames || []).forEach((optionName, index) => {
      const group = normalizeBundleOptionGroup(optionName);
      const preservedValue = semanticParams[group];
      if (!preservedValue) return;

      const optionValueExists = variants.some((variant) => variant.options[index] === preservedValue);
      if (!optionValueExists) return;

      setOptionInputValue(index, preservedValue);
      hasPreservedSelection = true;
    });

    url.searchParams.delete('ph_size');
    url.searchParams.delete('ph_stone');
    url.searchParams.delete('ph_finish');

    if (hasPreservedSelection && history.replaceState) {
      history.replaceState({ path: url.toString() }, '', url.toString());
    }

    return hasPreservedSelection;
  }

  function applyVariantFromUrlParam() {
    const url = new URL(window.location.href);
    const variantParam = Number(url.searchParams.get('variant'));
    if (!variantParam) return false;

    const matchedVariant = variants.find((variant) => Number(variant.id) === variantParam);
    if (!matchedVariant) return false;

    syncOptionUiFromVariant(matchedVariant);
    return true;
  }

  function updateFinishLinksWithSelectedLetter() {
    const selectedLetter = String(document.getElementById('LetterCharmSelection')?.value || '').trim().toUpperCase();
    document.querySelectorAll('[data-finish-link]').forEach((link) => {
      const href = link.getAttribute('href');
      if (!href) return;

      try {
        const nextUrl = new URL(href, window.location.origin);
        if (selectedLetter && selectedLetter !== 'NO LETTER') {
          nextUrl.searchParams.set('ph_letter', selectedLetter);
        } else {
          nextUrl.searchParams.delete('ph_letter');
        }

        const nextHref = nextUrl.origin === window.location.origin
          ? `${nextUrl.pathname}${nextUrl.search}${nextUrl.hash}`
          : nextUrl.toString();
        link.setAttribute('href', nextHref);
      } catch (error) {}
    });
  }

  function preserveSelectedOptionsOnFinishLinks() {
    const finishLinks = document.querySelectorAll(
      '[data-finish-link], .ph-pdp-finish-options .ph-pdp-alternative-options a, .custom-ph-pdp-alternative-options a.finish-option'
    );
    if (!finishLinks.length) return;

    finishLinks.forEach((link) => {
      link.addEventListener('click', function (event) {
        if (event.defaultPrevented) return;
        if (event.button !== 0 || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;

        const href = this.getAttribute('href');
        if (!href) return;

        const nextUrl = new URL(href, window.location.origin);

        const selectedSize = getBundleGroupValueFromMainSelection('size');
        const selectedStone = getBundleGroupValueFromMainSelection('stone');
        const selectedFinish = getBundleGroupValueFromMainSelection('finish');
        const selectedLetter = String(letterCharmInput?.value || '').trim().toUpperCase();

        if (selectedSize) nextUrl.searchParams.set('ph_size', selectedSize);
        if (selectedStone) nextUrl.searchParams.set('ph_stone', selectedStone);
        if (selectedFinish) nextUrl.searchParams.set('ph_finish', selectedFinish);
        if (selectedLetter && selectedLetter !== 'NO LETTER') {
          nextUrl.searchParams.set('ph_letter', selectedLetter);
        } else {
          nextUrl.searchParams.delete('ph_letter');
        }

        event.preventDefault();
        window.location.href = nextUrl.toString();
      });
    });
  }

  updateFinishLinksWithSelectedLetter();
  preserveSelectedOptionsOnFinishLinks();

  document.querySelectorAll('.ph-pdp-variant-boxes .ph-pdp-variant-box, .ph-pdp-size-boxes .ph-pdp-size-box, .ph-pdp-variant-text-options .ph-pdp-text-option').forEach((box) => {
