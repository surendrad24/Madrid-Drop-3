{% style %}
          .shopify-payment-button__more-options{
            display: none;
          }

          .button-content span{
            display: none;
          }

          .ph-pdp-content-more br:last-child {
              display: none;
          }

          .ph-pdp-product-container {
            max-width: 1750px;
            margin: 0 auto;
            position: relative;
            min-height: 100vh;
            margin-bottom: 3rem;
            opacity: 0; /* Start invisible for animation */
          }

          .ph-pdp-quantity-input {
            -moz-appearance: textfield;
          }

          .ph-pdp-quantity-input::-webkit-outer-spin-button,
          .ph-pdp-quantity-input::-webkit-inner-spin-button {
            -webkit-appearance: none;
            margin: 0;
          }

          .ph-pdp-quantity-selector {
            display: flex;
            align-items: center;
            justify-content: space-between;
            width: 100%;
            background: #f7f7f7;
          }

          .ph-pdp-quantity-input {
            width: 40px;
            height: 38px;
            border: none;
            text-align: center;
            font-size: 1.2rem;
            padding: 0;
            background: transparent;
          }

          .ph-sticky-title-wrapper {
      width: 50%;
    }




    .custom-ph-pdp-alternative-options {
    display: grid;
    grid-template-columns: 1fr 1fr; /* 2 per row */
    gap: 20px 0; /* vertical spacing between rows */
    margin-top: 10px;
  }

  .custom-ph-pdp-alternative-options .finish-col:nth-child(odd) {
    text-align: left; /* left align */
  }

  .custom-ph-pdp-alternative-options .finish-col:nth-child(even) {
    text-align: right; /* right align */
  }

  .custom-ph-pdp-alternative-options .finish-option {
    text-transform: uppercase;
    font-size: 10px;
    white-space: nowrap; /* prevent wrapping */
  }

  .custom-ph-pdp-alternative-options:first-child .finish-option {
      margin-bottom: 20px;
    }

    .finish-col:first-child .finish-option {
    border-bottom: 1px solid #333; /* underline effect */
    display: inline-block; /* ensures border aligns to text width */
    padding-bottom: 2px;   /* little breathing space */
  }



  /* Mobile: 1 column per row */
  @media (max-width: 767px) {
    .custom-ph-pdp-alternative-options {
      grid-template-columns: 1fr;   /* single column */
      gap: 12px 0;                   /* tighten vertical spacing if desired */
    }

    /* Normalize alignment on mobile */
    .custom-ph-pdp-alternative-options .finish-col {
      text-align: left !important;   /* override odd/even alignment */
    }

    /* Let labels wrap if needed on small screens */
    .custom-ph-pdp-alternative-options .finish-option {
      white-space: normal;
      font-size: 11px;               /* optional: slightly larger for readability */
    }

  }






          .ph-pdp-product-layout {
            display: flex;
            flex-direction: column-reverse;
            margin-bottom: 3rem;
          }

          .ph-pdp-option-group {
            margin-bottom: 0;
            padding: 1.8rem 0;
            border-bottom: 1.3px solid #f1f2ee;
            position: relative;
          }
        .ph-pdp-option-groupsize {
            margin-bottom: 0;
            padding: 1.8rem 0;
            border-bottom: 1.3px solid #f1f2ee;
            position: relative;
          }
          .ph-pdp-option-header {
            display: flex;
            flex-direction: column;
            align-items: flex-start;
            margin-bottom: 1.3rem;
            padding-bottom: 0.5rem;
          }


          .ph-pdp-product-description-wrapper {
            padding-bottom: 2.5rem;
            color: #1d1d1d;
            border-bottom: 1.3px solid #f1f2ee;
            position: relative;
            transition: height 0.3s ease;
            overflow: hidden;
            opacity: 0; /* Start invisible for animation */
          }
          .ph-pdp-product-description-wrapper a{
            font-family: "PhoriaBold" !important;
          }
          .ph-pdp-option-title {
            font-size: 10px;
            text-transform: uppercase;
            font-family: 'PhoriaBold';
          }


          .metafield-rich_text_field p{
            color: #1d1d1d;
            font-size: 10px;
            margin: 18px 0 0 0;
            line-height: 2.3;
            font-weight: 400 !important;
          }


          .ph-gift-card-note-pdp{
            color: #1d1d1d;
            font-family: "PhoriaRegular";
            font-size: 10px;
            margin: 18px 0 0 0;
            line-height: 2.3;
            font-weight: 400 !important;
          }

          .metafield-rich_text_field a{
            font-family: 'PhoriaBold';
          }


          .metafield-rich_text_field p strong {
            font-family: 'PhoriaBold';
          }

          .ph-pdp-option-header .ph-pdp-option-subtitle {
            display: none;
          }


          .ph-pdp-finish-options,
          .ph-pdp-stone-options {
            display: flex;
            flex-direction: column;
            align-items: flex-start;
            gap: 1rem;
          }

          .ph-pdp-main-option {
            font-size: 10px;
            text-transform: uppercase;
            padding-bottom: 5px;
            display: flex;
            align-items: center;
            gap: 0.9rem;
            font-family: 'PHoriaRegular', sans-serif;
            width: 100%;
            letter-spacing: 1px;
          }

          .ph-pdp-main-option span{
            border-bottom: 1px solid #333;
          }


          .ph-pdp-mobile-option-subtitle {
            font-size: 10px;
            color: #999;
            text-transform: uppercase;
            margin-top: 1rem;
            margin-bottom: 0.5rem;
            display: block;
          }

          .ph-pdp-alternative-options {
            display: flex;
            flex-direction: column;
            align-items: flex-start;
            gap: 1rem;
            font-size: 10px;
            width: 100%;
            text-transform: uppercase;
          }

          .ph-pdp-alternative-options-inside{
            display: flex;
          }

          .ph-pdp-alt-option {
            font-size: 10px;
            text-transform: uppercase;
            text-decoration: none;
            color: #000;
            display: flex;
            align-items: center;
            gap: 0.5rem;
          }


          .ph-pdp-stone-image {
            width: 20px;
            height: 20px;
            border-radius: 50%;
            border: 1.3px solid #f1f2ee;
            margin-right: 0.9rem;
            object-fit: cover;
          }

          .ph-pdp-product-details {
            width: 100%;
            padding: 36px 18px;
            overflow: visible !important;
          }

          .ph-pdp-option-mobiletitle{
            position: absolute;
            right: -4px;
            font-size: 10px;
          }

          .ph-pdp-product-title {
            font-size: 22px;
            text-transform: uppercase;
            margin: 0 0 1.5rem 0;
            font-family: 'PhoriaBold', sans-serif;
            opacity: 0; /* Start invisible for animation */
          }


          div[class*="shopify-section"] > div:first-child {
            padding-bottom: 1.5rem;
          }

          .ph-pdp-product-subtitle {
            font-size: 14px;
            text-transform: uppercase;
            margin: 0 0 1.5rem 0;
          }

          .ph-pdp-product-price {
            font-size: 18px;
            font-family: 'PhoriaBold';
            text-transform: uppercase;
            margin: 0 0 8px 0;
          }

.ph-pdp-product-compare-price {
  position: relative;
  text-decoration: none !important; /* remove the thick default line */
  color: #888;
  font-size: 0.9em;
}

.ph-pdp-product-compare-price::after {
  content: "";
  position: absolute;
  left: 0;
  right: 0;
  width: 92%;

  height: 1px; /* <— reduce thickness here */
  background: #888; /* line color */

  top: 50%; /* center the line */
  transform: translateY(-50%);
}


          .ph-pdp-starting-from-span-text {
            font-size: 10px;
            text-transform: uppercase;
          }


          .ph-pdp-product-description {
            font-size: 10px;
            color: #1d1d1d;
            text-transform: uppercase;
            line-height: 2.2;
            margin: 0 0 1.56rem 0;
            transition: opacity 0.3s ease;
          }


          .ph-pdp-read-more {
            display: inline-block;
            font-size: 10px;
            text-transform: uppercase;
            /* margin-top: 1rem; */
            margin-bottom: 2.5rem;
            padding: 0 0 2px 0;
            background: none;
            border: none;
            cursor: pointer;
            color: #000;
            font-family: 'PhoriaBold', sans-serif;
            transition: opacity 0.3s ease;
            position: relative;
          }

          .ph-pdp-product-media-list {
            display: flex;
            flex-direction: column;
            gap: 0 !important;
            line-height: 0;
            font-size: 0;
          }

          .ph-pdp-product-media-item {
            width: 100%;
            position: relative;
            margin: 0 !important;
            padding: 0 !important;
          }

          .ph-pdp-product-media-item--portrait {
            aspect-ratio: 4 / 5;
          }

          .ph-pdp-product-media-item--square {
            aspect-ratio: 1 / 1;
          }

          @supports not (aspect-ratio: 1 / 1) {
            .ph-pdp-product-media-item {
              height: 0;
            }

            .ph-pdp-product-media-item > * {
              position: absolute;
              inset: 0;
            }

            .ph-pdp-product-media-item--portrait {
              padding-top: 125%;
            }

            .ph-pdp-product-media-item--square {
              padding-top: 100%;
            }
          }

          .ph-pdp-product-video-container {
            width: 100%;
            height: 100%;
            position: relative;
            line-height: 0;
          }

          .ph-pdp-product-video {
            width: 100%;
            height: 100%;
            object-fit: cover;
            display: block;
          }


          .ph-pdp-variant-text-options {
            display: flex;
            gap: 1rem;
          }

          .ph-pdp-text-option {
            font-size: 0.75rem;
            text-transform: uppercase;
            cursor: pointer;
            padding-bottom: 5px;
            position: relative;
          }

          .ph-pdp-text-option.selected {
            font-weight: normal;
          }

          .ph-pdp-text-option.selected::after {
            content: '';
            position: absolute;
            height: 1px;
            background-color: #000;
            width: 100%;
            bottom: 0;
            left: 0;
          }


          .ph-pdp-variant-boxes {
            display: flex;
            gap: 0.5rem;
            margin-bottom: 1rem;
          }

          .ph-pdp-variant-box {
            border: 1px solid #ddd;
            border-radius: 50%;
            width: 30px;
            height: 30px;
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
          }

          .ph-pdp-variant-box.selected {
            border: 2px solid #000;
          }

          .ph-pdp-variant-box.color-green {
            background-color: #aec6a5;
          }

          .ph-pdp-variant-box.color-white {
            background-color: #f0f0f0;
          }


          .ph-pdp-variant-box-container {
            display: flex;
            align-items: center;
            margin-right: 1.5rem;
          }

          .ph-pdp-variant-label {
            font-size: 0.75rem;
            text-transform: uppercase;
            margin-left: 0.5rem;
          }


          .ph-pdp-variant-box.color-white-topaz {
            background-color: #f0f0f0;
          }

          .ph-pdp-variant-box.color-onyx {
            background-color: #000000;
          }

          .ph-pdp-variant-box.color-chrome-diopside {
            background-color: #4c9f4c;
          }

          .ph-pdp-variant-box.color-pink-tourmaline {
            background-color: #f0a0c0;
          }


          .ph-pdp-size-boxes {
            display: flex;
            gap: 2.9rem;
            flex-wrap: wrap;
          }

          .ph-pdp-size-box {
            padding-bottom: 5px;
            cursor: pointer;
            font-size: 10px;
            position: relative;
            font-family: 'PhoriaRegular', sans-serif;
            text-transform: uppercase;
          }

          .ph-pdp-size-box.selected::after {
            content: '';
            position: absolute;
            height: 1px;
            background-color: #000;
            width: 100%;
            bottom: 0;
            left: 0;
          }

          .ph-pdp-letter-charms-group {
            margin-top: 0.7rem;
          }

          .ph-pdp-letter-charms-no-letter {
            display: inline-flex;
            align-items: center;
            padding-bottom: 0.5rem;
            margin-bottom: 0;
            cursor: pointer;
            font-size: 10px;
            position: relative;
            font-family: 'PhoriaRegular', sans-serif;
            text-transform: uppercase;
            letter-spacing: 0.14em;
          }

          .ph-pdp-letter-charms-no-letter.selected::after {
            content: '';
            position: absolute;
            height: 1px;
            background-color: #000;
            width: 100%;
            bottom: 0;
            left: 0;
          }

          .ph-pdp-letter-charms-carousel {
            flex-wrap: nowrap !important;
            overflow-x: auto;
            overflow-y: hidden;
            padding-bottom: 0;
            padding-left: 0;
            padding-right: 0;
            gap: 2.8rem !important;
            -webkit-overflow-scrolling: touch;
            scrollbar-width: none;
            max-width: 100%;
            scroll-behavior: smooth;
          }

          .ph-pdp-letter-charms-carousel::-webkit-scrollbar {
            display: none;
          }

          .ph-pdp-letter-charms-carousel .ph-pdp-size-box {
            flex: 0 0 auto;
            font-size: 10px;
            letter-spacing: 0.1em;
            padding: 0 4px;
            color: #000;
            transition: color 0.2s ease;
          }

          .ph-pdp-letter-charms-carousel .ph-pdp-size-box.selected {
            color: #000;
            font-family: 'PhoriaBold', sans-serif;
          }

          .ph-pdp-letter-charms-carousel-wrapper {
            position: relative;
            display: flex;
            align-items: center;
            gap: 12px;
          }

          .ph-pdp-letter-charms-carousel-wrapper .ph-pdp-letter-charms-carousel {
            flex: 1;
            min-width: 0;
          }

          @media (min-width: 768px) {
            .ph-pdp-letter-charms-carousel-wrapper {
              width: min(100%, 620px);
              justify-content: center;
              gap: 14px;
            }
            .ph-pdp-letter-charms-carousel-wrapper .ph-pdp-letter-charms-carousel {
              flex: 0 1 500px;
              max-width: 500px;
              margin: 0 auto;
              gap: 2rem !important;
            }
          }

          .ph-pdp-letter-charms-arrow {
            background: none;
            border: none;
            cursor: pointer;
            width: 24px;
            height: 24px;
            padding: 0;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            font-size: 17px;
            color: #000;
            flex-shrink: 0;
            line-height: 1;
            user-select: none;
            transition: opacity 0.2s ease;
          }

          .ph-pdp-letter-charms-arrow:disabled {
            opacity: 0.2;
            cursor: default;
          }

          .ph-pdp-letter-charms-sub-header {
            display: flex;
            justify-content: space-between;
            align-items: baseline;
            margin-bottom: 2.3rem;
          }
          {% if product.handle == 'anywear-letter-charm-gold' or product.handle == 'anywear-letter-charm-silver' %}
          .ph-pdp-letter-charms-sub-header {
            margin-bottom: -1.3rem;
          }
          {% endif %}

          .ph-pdp-letter-charms-choose-text {
            display: inline-flex;
            align-items: center;
            padding-bottom: 0.5rem;
            font-size: 10px;
            text-transform: uppercase;
            font-family: 'PhoriaRegular', sans-serif;
            letter-spacing: 0.14em;
            color: #000;
            position: relative;
          }

          .ph-pdp-letter-charms-choose-text::after {
            content: '';
            position: absolute;
            height: 1px;
            background-color: #000;
            width: 100%;
            bottom: 0;
            left: 0;
          }

          .ph-pdp-letter-charms-group.is-no-letter .ph-pdp-letter-charms-choose-text::after {
            display: none;
          }

          .ph-pdp-letter-charms-group.is-no-letter .ph-pdp-letter-charms-carousel .ph-pdp-size-box {
            color: #bbb;
          }

          .ph-pdp-letter-charms-group.is-no-letter .ph-pdp-letter-charms-carousel .ph-pdp-size-box.selected {
            color: #bbb;
            font-family: 'PhoriaRegular', sans-serif;
          }

          .ph-pdp-letter-charms-group.is-no-letter .ph-pdp-letter-charms-carousel .ph-pdp-size-box.selected::after {
            display: none;
          }

          @media (max-width: 767px) {
            .ph-pdp-letter-charms-no-letter {
              margin-bottom: 1.3rem;
              padding-bottom: 0.5rem;
            }

            .ph-pdp-letter-charms-carousel {
              gap: 2rem !important;
            }

            .ph-pdp-letter-charms-carousel-wrapper {
              gap: 13px;
            }
          }


          .ph-pdp-add-to-cart-container {
            display: flex;
            gap: 1.7rem;
            flex-direction: column;
            justify-content: space-between;
            padding: 0rem 0 5.2rem 0;
            border-bottom: 1.3px solid #f1f2ee;
            width: 100%;
          }

          .ph-pdp-quantity-button {
            width: 50px;
            height: 50px;
            background: none;
            border: none;
            font-size: 1.8rem;
            cursor: pointer;
            color: #000;
          }

          .ph-pdp-add-to-cart-button {
            background-color: #1a1a1a;
            color: white;
            border: none;
            padding: 0 2rem;
            height: 42px;
            text-transform: uppercase;
            font-size: 10px;
            cursor: pointer;
            width: 100%;
            font-family: 'PhoriaBold', sans-serif;
            font-weight: normal !important;
          }


          .ph-pdp-accordion-section {
            border-bottom: 1.3px solid #f1f2ee;
            padding: 2.5rem 0;
            overflow: visible;
            position: static;
          }

          .ph-pdp-accordion-header {
            display: flex;
            gap: 0.5rem;
            justify-content: space-between;
            align-items: center;
            cursor: pointer;
          }

          .ph-pdp-accordion-title {
            font-size: 10px;
            text-transform: uppercase;
            font-family: 'PhoriaBold', sans-serif;
          }

          .ph-pdp-accordion-icon {
            font-size: 1.8rem;
            transition: transform 0.3s ease;
            transform-origin: center;
            display: inline-block;
            line-height: 1;
          }

          .ph-pdp-accordion-icon.open {
            transform: rotate(45deg);
          }

          .ph-pdp-accordion-content {
            overflow: hidden;
            transition: height 0.3s ease, opacity 0.3s ease;
            height: 0;
            opacity: 0;
            font-size: 10px;
            line-height: 2.3;
            padding: 0 1px;
          }

          .ph-pdp-accordion-content.open {
            height: auto;
            opacity: 1;
          }

          .ph-pdp-accordion-content .ph-fitnote-strong {
            font-family: 'PhoriaBold', sans-serif !important;
            font-weight: 400 !important;
          }

          .ph-pdp-accordion-content p,
          .ph-pdp-accordion-content li,
          .ph-pdp-accordion-content span,
          .ph-pdp-accordion-content a,
          .ph-pdp-accordion-content strong,
          .ph-pdp-accordion-content h1,
          .ph-pdp-accordion-content h2,
          .ph-pdp-accordion-content h3,
          .ph-pdp-accordion-content h4,
          .ph-pdp-accordion-content h5,
          .ph-pdp-accordion-content h6 {
            font-size: 10px;
            line-height: 2.3;
            text-transform: uppercase;
          }

          .ph-pdp-accordion-content p,
          .ph-pdp-accordion-content li {
            margin: 18px 0;
          }


          .ph-pdp-accordion-section + .ph-pdp-accordion-section {
            margin-top: 0;
          }


          .ph-pdp-product-images {
            width: 100%;
            padding: 0 18px;
            scroll-behavior: smooth;
          }

          .ph-pdp-product-image-list {
            display: flex;
            flex-direction: column;
            gap: 0;
          }

          .ph-pdp-product-image-item {
            aspect-ratio: 4 / 5;
            width: 100%;
            position: relative;
          }

          @supports not (aspect-ratio: 1 / 1) {
            .ph-pdp-product-image-item {
              height: 0;
              padding-top: 125%;
            }

            .ph-pdp-product-image-item > * {
              position: absolute;
              inset: 0;
            }
          }

          .ph-pdp-product-image {
            width: 100%;
            height: 100%;
            object-fit: cover;
            display: block;
          }

          /* Class for animating the whole details section */
          .ph-pdp-product-details--animate {
            opacity: 0; /* Start invisible for animation */
          }

          @media (min-width: 767px) {
            .ph-pdp-mobile-option-subtitle {
              display: none;
            }

             .ph-pdp-option-header .ph-pdp-option-subtitle {
              display: block;
              font-size: 10px;
              color: #999;
            }

            .ph-pdp-finish-options, .ph-pdp-stone-options {
                  flex-direction: row;
                  justify-content: space-between;
                  gap: 0.55rem;
              }

            .ph-pdp-alternative-options{
              align-items: flex-end;
            }

            .ph-pdp-option-header{
              flex-direction: row;
              justify-content: space-between;
            }

          }

          @media (min-width: 1024px) {
            .ph-pdp-product-layout {
              flex-direction: row;
              align-items: flex-start;
            }

            .ph-pdp-product-details--animate,
            .ph-pdp-product-subtitle,
            .ph-pdp-product-description-wrapper{
              max-width: 576px;
            }


            .ph-pdp-option-mobiletitle{
              display: none;
            }

            .ph-pdp-product-title, .ph-pdp-product-subtitle{
              margin: 0 0 23px 0;
            }

            .shopify-product-form{
              max-width: 640px
            }

            .ph-pdp-product-images {
             padding: 0;
            }

            .ph-pdp-product-images,
            .ph-pdp-product-details {
              width: 50%;
            }

            .ph-pdp-add-to-cart-button {
              width: auto;
              min-width: 200px;
            }

            .ph-pdp-product-details {
              position: sticky;
              top: 100px;
              padding: 33px 18px 2rem 72px;
              height: auto;
              max-height: none;
              overflow-y: visible;
              /* z-index: 10;  */
              background-color: #fff;
            }

            .ph-pdp-product-title {
              font-size: 32px;
              margin-left: -5px;
            }

            .ph-pdp-product-container + * {
              padding-top: 2rem;
              position: relative;
              z-index: 5;
            }

            .ph-pdp-product-images {
              overflow-y: auto;
              margin-top: 36px;
              border-left: 2px solid #f1f2ee;
              scrollbar-width: none;
              -ms-overflow-style: none;
              scroll-behavior: smooth;
            }


            .ph-pdp-product-images::-webkit-scrollbar {
              display: none;
            }

            html {
              scroll-behavior: smooth;
            }


            .ph-pdp-product-image-list {
              padding-bottom: 2rem;
            }

            .ph-pdp-option-header {
              flex-direction: row;
              justify-content: space-between;
