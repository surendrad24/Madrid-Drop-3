  document.querySelectorAll('.ph-pdp-accordion-header').forEach((header) => {
    header.addEventListener('click', function() {
      const content = this.nextElementSibling;
      const icon = this.querySelector('.ph-pdp-accordion-icon');
      const section = this.closest('.ph-pdp-accordion-section');
      
      icon.classList.toggle('open');
      
      if (content.classList.contains('open')) {
