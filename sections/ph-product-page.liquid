    const letterAndNoChain = letterVariants.find((variant) => {
      const options = [variant.option1, variant.option2, variant.option3]
        .filter(Boolean)
        .map((option) => option.toString().trim().toUpperCase());
      const matchesLetter = options.some((option) => optionMatchesSelectedLetter(option, normalizedLetter));
      const hasNoChain = options.some((option) => optionIsNoChain(option));
      return matchesLetter && hasNoChain;
    });

    if (letterAndNoChain) return letterAndNoChain;
    if (requireNoChain) return null;

    return letterVariants.find((variant) => {
      const options = [variant.option1, variant.option2, variant.option3]
        .filter(Boolean)
