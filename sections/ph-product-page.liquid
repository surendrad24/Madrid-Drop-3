      if (baseVariant) {
        doubleBasePriceCache.unitPrice = normalizePriceToCents(baseVariant.price || 0);
        doubleBasePriceCache.variantId = Number(baseVariant.id) || null;
      }
    } catch (error) {
      console.warn('Double-base price prefetch failed:', error);
    } finally {
      doubleBasePriceCache.loaded = true;
      doubleBasePriceCache.loading = false;
