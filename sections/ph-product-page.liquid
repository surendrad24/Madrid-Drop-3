      const value = this.getAttribute('data-option-value');

      setOptionInputValue(optionIndex, value);

      const boxes = parent.querySelectorAll('.ph-pdp-variant-box, .ph-pdp-size-box, .ph-pdp-text-option');
      boxes.forEach(box => box.classList.remove('selected'));
      this.classList.add('selected');

      updateVariantSelection(optionIndex, value);
    });
  });
  
  const decreaseButtons = document.querySelectorAll('.ph-pdp-quantity-button.decrease');
