  }

  async function fetchStorefrontProductById(productId) {
    const numericId = Number(productId);
    if (!numericId) return null;
    if (storefrontProductIdCache[numericId]) return storefrontProductIdCache[numericId];

    try {
      const limit = 250;
      for (let page = 1; page <= 12; page += 1) {
        const response = await fetch(`/products.json?limit=${limit}&page=${page}`);
        if (!response.ok) break;
        const payload = await response.json();
        const products = Array.isArray(payload?.products) ? payload.products : [];
        if (!products.length) break;

        const matched = products.find((productData) => Number(productData?.id) === numericId);
        if (matched) {
          storefrontProductIdCache[numericId] = matched;
          return matched;
        }

        if (products.length < limit) break;
      }
    } catch (error) {
      console.warn(`Could not resolve storefront product by id "${numericId}"`, error);
    }

    storefrontProductIdCache[numericId] = null;
    return null;
  }

