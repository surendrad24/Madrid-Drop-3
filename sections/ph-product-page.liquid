  function applyNonAnywearLetterBundlePrice(letterValue) {
    if (!letterCharmsEnabled || isAnywearSelectorProduct) return;
    
    const selectedVariantId = Number(document.querySelector('input[name="id"]')?.value);
    const currentVariant = variants.find((v) => Number(v.id) === selectedVariantId) || variants[0];
    
    const currentOptions = [currentVariant.option1, currentVariant.option2, currentVariant.option3].filter(Boolean).map(o => o.toUpperCase());
    
    let noLetterVariant = variants.find(v => {
      const vOpts = [v.option1, v.option2, v.option3].filter(Boolean).map(o => o.toUpperCase());
      const hasNoLetter = vOpts.some(o => o.includes('NO LETTER') || o === 'NONE' || o === 'PICK YOUR CHARM');
      if (!hasNoLetter) return false;
      
      return vOpts.every(o => {
        const isLetterOpt = o.includes('NO LETTER') || o === 'NONE' || o === 'PICK YOUR CHARM' || (o.length === 1 && o >= 'A' && o <= 'Z');
        return isLetterOpt || currentOptions.includes(o);
      });
    });

    if (!noLetterVariant) {
      noLetterVariant = variants.find(v => {
        const vOpts = [v.option1, v.option2, v.option3].filter(Boolean).map(o => o.toUpperCase());
        return vOpts.some(o => o.includes('NO LETTER') || o === 'NONE');
      });
    }

    const hasExplicitNoLetterVariant = Boolean(noLetterVariant);
    if (!noLetterVariant) noLetterVariant = variants[0];

    let basePrice = normalizePriceToCents(noLetterVariant.price || 0);
    if (isChainSourceProduct) {
      const selectedSize = resolveVariantSizeKey(currentVariant);
      const chainPrice = selectedSize ? Number(chainSourcePriceCache.bySize[selectedSize] || 0) : 0;
      if (chainPrice > 0) {
        basePrice = chainPrice;
      } else {
        const availableChainPrices = Object.values(chainSourcePriceCache.bySize)
          .map((v) => Number(v || 0))
          .filter((v) => v > 0);
        if (availableChainPrices.length) {
          basePrice = Math.min(...availableChainPrices);
        }
      }
    }
    if (isDoubleBaseSelectorProduct) {
      const configuredQty = Number(activeDoubleBaseConfig?.baseQuantity || 2);
      const computed = Number(doubleBasePriceCache.unitPrice || 0) * configuredQty;
      basePrice = computed || Number(activeDoubleBaseConfig?.baseTotalPriceCents || 54000);
    }

    if (isChainSourceProduct && (!Number.isFinite(basePrice) || basePrice <= 0)) {
      if (currentProductId === 10506235674890 || currentHandle === 'the-i-d-charm-bracelet-1') basePrice = 28500;
      if (currentProductId === 10506235838730 || currentHandle === 'the-i-d-charm-bracelet') basePrice = 23500;
    }
    const normalizedLetter = (letterValue || 'NO LETTER').toString().trim().toUpperCase();

    if (isChainSourceProduct) {
      const selectedSize = resolveVariantSizeKey(currentVariant);
      const chainBaseFromCache = selectedSize ? Number(chainSourcePriceCache.bySize[selectedSize] || 0) : 0;
      const configuredBase = selectedSize
        ? Number(activeChainSourceConfig?.sizePriceByKey?.[selectedSize] || 0)
        : 0;

      let chainBasePrice = chainBaseFromCache || configuredBase;
      if (!Number.isFinite(chainBasePrice) || chainBasePrice <= 0) {
        if (currentProductId === 10506235674890) chainBasePrice = 28500;
        if (currentProductId === 10506235838730) chainBasePrice = 23500;
      }

      const fallbackAddon = Number(activeChainSourceConfig?.letterNoChainPrice || 0)
        || (currentProductId === 10506235674890 ? 11000 : 8500);
      const addonFromCache = Number(letterAddonPriceCache.byLetter[normalizedLetter] || 0);
      const resolvedAddon = normalizedLetter === 'NO LETTER'
        ? 0
        : (addonFromCache > 0 ? addonFromCache : fallbackAddon);

      const forcedTotal = Number(chainBasePrice || 0) + Number(resolvedAddon || 0);
      if (Number.isFinite(forcedTotal) && forcedTotal > 0) {
        renderCombinedDisplayedPrice(forcedTotal);
        return;
      }
    }
    
    let letterPrice = normalizedLetter === 'NO LETTER'
      ? 0
      : Number(letterAddonPriceCache.byLetter[normalizedLetter] || 0);

    if (normalizedLetter === 'NO LETTER' && !hasExplicitNoLetterVariant) {
      const currentLetter = [currentVariant.option1, currentVariant.option2, currentVariant.option3]
        .filter(Boolean)
        .map((o) => o.toString().trim().toUpperCase())
        .find((o) => o.length === 1 && o >= 'A' && o <= 'Z');

      let inferredAddon = Number(letterAddonPriceCache.byLetter[currentLetter] || 0);
      if (!inferredAddon) {
        if (currentProductId === 10498031583498 || currentHandle == 'the-i-d-modular-charm-necklace-gold') inferredAddon = 11000;
        if (currentProductId === 10498030633226 || currentHandle == 'the-i-d-modular-charm-necklace-silver') inferredAddon = 8500;
      }
      if (inferredAddon > 0) {
        basePrice = Math.max(0, normalizePriceToCents(currentVariant.price || 0) - inferredAddon);
      }
    }
    
    
    if (!Number.isFinite(basePrice) || basePrice < 0) {
      basePrice = normalizePriceToCents(currentVariant?.price || 0);
    }
    if ((!Number.isFinite(basePrice) || basePrice <= 0) && currentHandle === 'the-i-d-charm-bracelet-1') {
      basePrice = 28500;
    }
    if ((!Number.isFinite(basePrice) || basePrice <= 0) && currentHandle === 'the-i-d-charm-bracelet') {
      basePrice = 23500;
    }

    if (normalizedLetter !== 'NO LETTER' && (!Number.isFinite(letterPrice) || letterPrice <= 0)) {
      const currentLetter = [currentVariant?.option1, currentVariant?.option2, currentVariant?.option3]
        .filter(Boolean)
        .map((o) => o.toString().trim().toUpperCase())
        .find((o) => o.length === 1 && o >= 'A' && o <= 'Z');

      if (currentLetter) {
        const currentLetterPrice = Number(letterAddonPriceCache.byLetter[currentLetter] || 0);
        if (currentLetterPrice > 0) {
          const displayedVariantPrice = normalizePriceToCents(currentVariant?.price || 0);
          letterPrice = Math.max(0, displayedVariantPrice - basePrice);
        }
      }
    }

    if (normalizedLetter === 'NO LETTER' && (!Number.isFinite(basePrice) || basePrice <= 0)) {
      const currentLetter = [currentVariant?.option1, currentVariant?.option2, currentVariant?.option3]
        .filter(Boolean)
        .map((o) => o.toString().trim().toUpperCase())
        .find((o) => o.length === 1 && o >= 'A' && o <= 'Z');
      const currentLetterPrice = Number(letterAddonPriceCache.byLetter[currentLetter] || 0);
      const displayedVariantPrice = normalizePriceToCents(currentVariant?.price || 0);
      if (currentLetterPrice > 0 && displayedVariantPrice > 0) {
        basePrice = Math.max(0, displayedVariantPrice - currentLetterPrice);
      }
    }

    const safeLetterPrice = Number.isFinite(letterPrice) && letterPrice > 0 ? letterPrice : 0;
    const totalToRender = basePrice + safeLetterPrice;
    if (!Number.isFinite(totalToRender) || totalToRender <= 0) return;

    setTimeout(() => {
      renderCombinedDisplayedPrice(totalToRender);
    }, 50);
  }

