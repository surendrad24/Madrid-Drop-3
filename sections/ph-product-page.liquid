    const originalEl = document.querySelector('[data-original-price]');
    const discountEl = document.querySelector('[data-discount-price]');
    const stickyPriceEl = document.querySelector('.ph-sticky-price');

    if (priceElement) priceElement.textContent = formatted;
    if (originalEl) originalEl.textContent = formatted;
    if (discountEl) discountEl.textContent = formatted;
    if (stickyPriceEl) stickyPriceEl.textContent = formatted;
