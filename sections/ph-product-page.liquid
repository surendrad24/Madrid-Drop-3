        content.style.maxheight = '0';
        
        setTimeout(() => {
          content.classList.remove('open');
          content.style.display = 'none';
        }, 300);
      } else {
        content.style.display = 'block';
        content.style.height = '0';
        content.classList.add('open');
        
        content.offsetHeight;
        
        const contentHeight = content.scrollHeight;
        content.style.height = contentHeight + 'px';
        
        setTimeout(() => {
          content.style.height = 'auto';
        }, 300);
        
        if (window.innerWidth >= 1024) {
          const productImages = document.querySelector('.ph-pdp-product-images');
          if (productImages) {
            const headerOffset = header.getBoundingClientRect().top + window.scrollY;
            productImages.scrollTo({
              top: headerOffset - productImages.getBoundingClientRect().top,
              behavior: 'smooth'
            });
          }
        }
      }
    });
  });
  
  document.querySelectorAll('.ph-pdp-accordion-content').forEach((content) => {
    content.style.display = 'none';
    content.style.height = '0';
