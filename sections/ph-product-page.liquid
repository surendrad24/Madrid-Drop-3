  /* Back-in-stock (BIS) modal */
  .ph-bis-modal {
    display: none;
    position: fixed;
    inset: 0;
    z-index: 99999;
    justify-content: center;
    align-items: center;
    visibility: hidden;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.3s ease, visibility 0.3s ease;
  }
  .ph-bis-modal.is-open {
    display: flex;
    visibility: visible;
    opacity: 1;
    pointer-events: auto;
  }
  .ph-bis-backdrop {
    position: absolute;
    inset: 0;
    background: rgba(0,0,0,0.55);
  }
  .ph-bis-dialog {
    position: relative;
    z-index: 1;
    background: #fff;
    border-radius: 0;
    padding: 24px;
    width: min(92vw, 520px);
    box-shadow: 0 20px 40px rgba(0,0,0,0.2);
    transition: transform 0.2s ease;
  }
  .ph-bis-modal[aria-hidden="true"] .ph-bis-dialog { transform: translateY(6px); }
  .ph-bis-modal.is-open .ph-bis-dialog { transform: none; }
  .ph-bis-close { position:absolute; right:8px; top:6px; background:transparent; border:0; font-size:28px; line-height:1; cursor:pointer; }



