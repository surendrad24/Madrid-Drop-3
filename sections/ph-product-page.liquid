                      <div class="ph-pdp-option-title">
                        {% if size_option.name == 'Size' -%}
                          SIZE
                        {%- elsif size_option.name == 'Price' or size_option.name == 'Denominations' %}
                          PRICE
                        {% else %}
                          {{ size_option.name | upcase }}
                        {% endif %}
                      </div>
                      {% if size_option.name != 'Price' and product.handle != 'gift-card' and hide_size_style_guide == false -%}
                        <span id="ph-size__chart--trigger__mobile" class="ph-pdp-option-mobiletitle"
                          >Size + Style Guide</span
                        >
                        <div class="ph-pdp-option-subtitle" style="color:black;">
                          {% if product.collections contains 'crystallised-collection' %}
                            <span id="ph-prsize__chart--trigger__desktop"> Size + Style Guide </span>
                          {% else %}
                            {% unless hide_size_style_guide %}
                              <span id="ph-size__chart--trigger__desktop"> Size + Style Guide</span>
                            {% endunless %}
                          {% endif %}
                        </div>
                      {% endif %}
                    </div>

                    

                    <div class="ph-pdp-size-boxes{% if is_id_waist_chain_product and size_option.name == 'Size' %} ph-pdp-waist-size-boxes{% endif %}" data-option-index="{{ size_option_index }}">
                      {% for value in size_option.values %}
                        {% assign normalized_size_value = value | handle %}
                        {% assign should_hide_size_value = false %}
                        {% if hidden_uk_sizes contains normalized_size_value %}
