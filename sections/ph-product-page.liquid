    if (!option || !letter) return false;
    if (option === letter) return true;
    const lettersOnly = option.replace(/[^A-Z]/g, '');
    if (lettersOnly === letter) return true;
    return option.includes(` ${letter} `) || option.startsWith(`${letter} `) || option.endsWith(` ${letter}`) || option.endsWith(`-${letter}`);
  }

  function optionIsNoChain(optionValue) {
    const option = normalizeOptionForLetterMatching(optionValue);
    return option.includes('NO CHAIN') || option === 'NONE' || option === 'NO';
