                      return String(value || '').toLowerCase().includes('no chain');
                    }
                    return String(value || '') === String(selectedOptions[index] || '');
                  });
                });
                if (noChainCandidate?.id) {
                  baseVariantId = Number(noChainCandidate.id);
                }
              }

              const lcBundleKey = wantsChain ? `phlc_${Date.now()}_${Math.random().toString(36).slice(2, 8)}` : '';
              const baseItem = {
                id: baseVariantId,
                quantity: addQuantity,
                properties: {
                  ...baseProperties,
                  _lc_display_title: activeDisplayTitle
                }
              };
              if (wantsChain && lcBundleKey) {
                baseItem.properties._lc_bundle_key = lcBundleKey;
                baseItem.properties._lc_parent_bundle = 'true';
                baseItem.properties._selected_chain = chainOptionValue;
              }

              const itemsToAdd = [];
              if (wantsChain && chainVariantId) {
                itemsToAdd.push({
                  id: chainVariantId,
                  quantity: addQuantity,
                  properties: {
                    _lc_bundle_key: lcBundleKey,
                    _lc_hidden_component: 'true'
                  }
                });
              }
              itemsToAdd.push(baseItem);

              const response = await fetch('/cart/add.js', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ items: itemsToAdd })
              });
              if (!response.ok) {
                throw new Error(`Network response was not ok: ${response.status}`);
              }
            } else {
            const baseProperties = {};
            for (const [key, value] of formData.entries()) {
              const match = /^properties\[(.+)\]$/.exec(String(key));
              if (!match) continue;
              baseProperties[match[1]] = value;
            }
            const sellingPlanId = formData.get('selling_plan');
            const sharedLcBundleKey = lcBundleKey || `phlc_${Date.now()}_${Math.random().toString(36).slice(2, 8)}`;
            const isNoLetterSelection = selectedLetterCharm === 'NO LETTER';
            const baseItems = [];

            if (isDoubleBaseSelectorProduct) {
              const resolvedBaseVariant = await resolveDoubleBaseVariant();
              const doubleBaseVariantId = Number(resolvedBaseVariant?.id || 0);
              if (!doubleBaseVariantId) {
                throw new Error('Double-base selector base variant could not be resolved.');
              }

              const visibleProperties = {
                ...baseProperties,
                _lc_bundle_key: sharedLcBundleKey,
                _lc_parent_bundle: 'true',
                _letter_charm: selectedLetterCharm,
                _lc_display_title: activeDisplayTitle
              };
              const hiddenProperties = {
                ...baseProperties,
                _lc_bundle_key: sharedLcBundleKey,
                _lc_hidden_component: 'true',
                _lc_component_role: 'secondary_base',
                _letter_charm: selectedLetterCharm
              };

              baseItems.push({
                id: doubleBaseVariantId,
                quantity: addQuantity,
                properties: visibleProperties
              });
              baseItems.push({
                id: doubleBaseVariantId,
                quantity: addQuantity,
                properties: hiddenProperties
              });
            } else {
              let baseVariantId = Number(formData.get('id'));
              if (isChainSourceProduct && activeChainSourceConfig) {
                await prefetchChainSourcePrices();
                const sel = variants.find((v) => Number(v.id) === baseVariantId);
                const sz = resolveVariantSizeKey(sel);
                const mappedVariantId = resolveChainSourceVariantIdForSize(sz);
                baseVariantId = mappedVariantId || baseVariantId;
              }
              if (!baseVariantId) {
                throw new Error('Base variant id is missing from product form.');
              }
              const baseItem = {
                id: baseVariantId,
                quantity: addQuantity
              };
              if (Object.keys(baseProperties).length) {
                baseItem.properties = baseProperties;
              }
              baseItem.properties = baseItem.properties || {};
              baseItem.properties._lc_display_title = activeDisplayTitle;
              if (isChainSourceProduct && !isNoLetterSelection) {
                baseItem.properties._lc_parent_bundle = 'true';
                baseItem.properties._linked_parent_product = {{ product.title | json }};
                baseItem.properties._linked_parent_handle = {{ product.handle | json }};
              }
              baseItems.push(baseItem);
            }

            if (sellingPlanId) {
              baseItems.forEach((entry) => {
                entry.selling_plan = Number(sellingPlanId) || sellingPlanId;
              });
            }

            let pendantItem = null;
            if (
              letterCharmsEnabled
              && !isNoLetterSelection
              && letterPendantHandle
            ) {
              const letterProductData = await resolveAnywearLetterProductData();
              if (letterProductData) {
                const letterVariants = Array.isArray(letterProductData?.variants) ? letterProductData.variants : [];
                const letterVariant = findLetterVariantBySelection(
                  letterVariants,
                  selectedLetterCharm,
                  isChainSourceProduct
                );

                if (letterVariant) {
                  pendantItem = {
                    id: letterVariant.id,
                    quantity: addQuantity,
                    properties: {
                      _linked_parent_product: {{ product.title | json }},
                      _selected_letter: selectedLetterCharm,
                      _lc_bundle_key: sharedLcBundleKey
                    }
                  };
                } else {
                  console.warn(`No letter pendant variant found for letter "${selectedLetterCharm}"`);
                }
              } else {
                console.warn(`Could not load letter pendant product for handle "${letterPendantHandle}"`);
              }
            }

            const itemsToAdd = pendantItem ? [pendantItem, ...baseItems] : [...baseItems];
            const response = await fetch('/cart/add.js', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ items: itemsToAdd })
            });
            if (!response.ok) {
              throw new Error(`Network response was not ok: ${response.status}`);
            }
            }
          }
        
          localStorage.setItem('openCartDrawerAfterReload', 'true');
          
          window.location.reload();
        
        } catch (error) {
          console.error('Error adding to cart:', error);
        }

      }



      
      
    });
  } else {
    console.error('Product form not found on page');
  }
  
function formatMoney(cents, currency, locale = 'en') {
  if (isNaN(cents) || cents === null) {
    return '0';
  }
  
  const amount = cents / 100;
  
  let formatted = new Intl.NumberFormat(locale, { 
    style: 'currency', 
    currency: currency,
    minimumFractionDigits: 0,
    maximumFractionDigits: 0
  }).format(amount);

  if (currency === 'INR') {
    formatted = formatted.replace('₹', 'RS, ');
  }

  return formatted.replace(/\./g, ',');
}
  document.addEventListener('DOMContentLoaded', function() {
  if (window.innerWidth >= 1024) {
    const productImages = document.querySelector('.ph-pdp-product-images');
    
    if (productImages) {
      productImages.style.scrollBehavior = 'smooth';
      
      productImages.addEventListener('wheel', function(e) {
        const slowScrollFactor = 0.2;
        const slowScrollAmount = e.deltaY * slowScrollFactor;
        
        productImages.scrollBy({
          top: slowScrollAmount,
          behavior: 'smooth'
        });
      }, { passive: true });
      
      let touchStartY = 0;
      let touchEndY = 0;
      
      productImages.addEventListener('touchstart', function(e) {
        touchStartY = e.changedTouches[0].screenY;
      }, { passive: true });
      
      productImages.addEventListener('touchmove', function(e) {
        touchEndY = e.changedTouches[0].screenY;
        const touchDiff = touchStartY - touchEndY;
        
        productImages.scrollBy({
          top: touchDiff * 0.2, 
          behavior: 'smooth'
        });
        
        touchStartY = touchEndY;
      }, { passive: true });
    }
  }
});
});
</script>

<script>
document.addEventListener('DOMContentLoaded', function () {
  const forceUppercaseSelect = (selectEl) => {
    if (!selectEl) return;
    const options = Array.from(selectEl.options || []);
    options.forEach((opt) => {
      const rawText = (opt.textContent || '').trim();
      if (!rawText) return;
      const upper = rawText.toUpperCase();
      if (opt.textContent !== upper) opt.textContent = upper;
      if (opt.label !== upper) opt.label = upper;
      opt.setAttribute('title', upper);
    });
    const labelEl = selectEl.closest('.ph-pdp-option-groupsize')?.querySelector('.ph-pdp-option-title');
    const labelText = (labelEl?.textContent || '').trim();
    if (labelText) {
      const upperLabel = labelText.toUpperCase();
      selectEl.setAttribute('aria-label', upperLabel);
      selectEl.setAttribute('title', upperLabel);
    }
  };

  const forceUppercaseAllProductSelects = () => {
    document.querySelectorAll('.ph-pdp-product-container select, #phStickyBar select').forEach((selectEl) => {
      forceUppercaseSelect(selectEl);
    });
  };

  forceUppercaseAllProductSelects();

  const mainBtn   = document.querySelector('.ph-pdp-add-to-cart-button');
  const notifyBtn = document.getElementById('notify-button');
  const stickyBar = document.getElementById('phStickyBar');
  const stickyBtn = document.getElementById('phStickyAddToCart');
  const stickySel = document.getElementById('phStickySizeSelect'); // may be null
  const stickyLetterSel = document.getElementById('phStickyLetterCharmSelect'); // may be null

  if (!stickyBar || !stickyBtn) return;

  if (stickySel) {
    const wrap = stickySel.parentElement; // <span class="ph-sticky-select-wrap">
    stickySel.addEventListener('mousedown',  () => wrap.classList.add('is-open'));
    stickySel.addEventListener('touchstart', () => wrap.classList.add('is-open'), { passive: true });
    stickySel.addEventListener('change',   () => {
      wrap.classList.remove('is-open');
      forceUppercaseSelect(stickySel);
    });
    stickySel.addEventListener('blur',     () => wrap.classList.remove('is-open'));
    forceUppercaseSelect(stickySel);
  }
  if (stickyLetterSel) {
    const wrap = stickyLetterSel.parentElement;
    stickyLetterSel.addEventListener('mousedown',  () => wrap.classList.add('is-open'));
    stickyLetterSel.addEventListener('touchstart', () => wrap.classList.add('is-open'), { passive: true });
    stickyLetterSel.addEventListener('change',   () => {
      wrap.classList.remove('is-open');
      forceUppercaseSelect(stickyLetterSel);
    });
    stickyLetterSel.addEventListener('blur',     () => wrap.classList.remove('is-open'));
    forceUppercaseSelect(stickyLetterSel);
  }

  document.body.appendChild(stickyBar);
  document.body.classList.add('has-sticky-add');

  const updateVariantSelection =
    typeof window.updateVariantSelection === 'function' ? window.updateVariantSelection : () => {};

  const notifyIsVisible = () =>
    !!(notifyBtn && !notifyBtn.classList.contains('hidden') && notifyBtn.offsetParent);

  const isCartOpen = () => {
    const cd = document.querySelector('cart-drawer');
    const nativeOpen = cd && (cd.classList.contains('active') || cd.hasAttribute('open'));
    const bodyLocked =
      document.body.classList.contains('overflow-hidden') ||
      document.body.classList.contains('cart-overflow-hidden');
    const legacy = document.getElementById('CartDrawer');
    const legacyOpen = legacy && legacy.classList.contains('active');
    return !!(nativeOpen || bodyLocked || legacyOpen);
  };

  function syncState() {
    if (notifyIsVisible()) {
      stickyBtn.disabled = false;
      stickyBtn.textContent = notifyBtn.textContent || 'Notify me';
      stickyBtn.dataset.mode = 'notify';
    } else {
      const disabled = !!(mainBtn && mainBtn.disabled);
      stickyBtn.disabled = disabled;
      stickyBtn.style.opacity = disabled ? '0.65' : '1';
      stickyBtn.textContent = (mainBtn && mainBtn.textContent?.trim()) || 'ADD TO BASKET';
      stickyBtn.dataset.mode = 'add';
    }

    if (stickySel) {
      const hiddenInput = document.getElementById(`Option${stickySel.dataset.optionIndex}`);
      const hasMatchingOption = hiddenInput && hiddenInput.value && Array.from(stickySel.options).some((opt) => opt.value === hiddenInput.value);
      if (hasMatchingOption) {
        stickySel.value = hiddenInput.value;
        forceUppercaseSelect(stickySel);
      }
    }
  }

  syncState();
  if (mainBtn) {
    new MutationObserver(() => { syncState(); toggleVisibility(); }).observe(mainBtn, {
      attributes: true, attributeFilter: ['disabled', 'class', 'style'], childList: true, subtree: true
    });
  }
  if (notifyBtn) {
    new MutationObserver(() => { syncState(); toggleVisibility(); }).observe(notifyBtn, {
      attributes: true, attributeFilter: ['class', 'style'], childList: true, subtree: true
    });
  }

  const scrollTopForStickySelection = () => {
    if (window.innerWidth >= 1024) return;
    const doScroll = () => window.scrollTo({ top: 0, behavior: 'smooth' });
    doScroll();
    requestAnimationFrame(() => setTimeout(doScroll, 40));
  };
  if (stickySel) {
    stickySel.addEventListener('change', () => {
      const idx = +stickySel.dataset.optionIndex;
      const hiddenInput = document.getElementById(`Option${idx}`);
      if (hiddenInput) {
        hiddenInput.value = stickySel.value;
        document.querySelectorAll('.ph-pdp-size-box[data-option-value]').forEach(el => {
          el.classList.toggle('selected', el.dataset.optionValue === stickySel.value);
        });
        updateVariantSelection(idx, stickySel.value);
        if (!stickyLetterSel) scrollTopForStickySelection();
      }
    });
  }

  stickyBtn.addEventListener('click', (e) => {
    e.preventDefault();
    const mode = stickyBtn.dataset.mode ||
      (typeof window.__phStickyMode === 'function' ? window.__phStickyMode() : 'add');
    if (mode === 'notify') {
      notifyBtn?.click();     // opens your BIS modal
    } else {
      mainBtn?.click();       // normal add to cart
    }
  });

  const getActiveCta = () => (notifyIsVisible() ? notifyBtn : mainBtn);
  function toggleVisibility() {
    const cta = getActiveCta();
    if (!cta) return;
    const r = cta.getBoundingClientRect();
    const anyPartVisible = r.height > 0 && r.top < window.innerHeight && r.bottom > 0;
    const shouldHide = anyPartVisible || isCartOpen();
    stickyBar.classList.toggle('is-hidden', shouldHide);
  }

  toggleVisibility();
  window.addEventListener('scroll', toggleVisibility, { passive: true });
  window.addEventListener('resize', toggleVisibility);
});
</script>

<script>
   document.addEventListener("DOMContentLoaded", function () {
    const addToCartButton = document.getElementById("dynamic-button");
    const notifyButton = document.getElementById("notify-button");  // Notify Me button
    const dynamicPreOrderText = document.getElementById("preorder-custom-text");

    const variantInput = document.querySelector('input[name="id"]');

    const productHandle = "{{ product.handle }}";

    const variants = [
  {% for variant in product.variants %}
    {
      id: {{ variant.id }},
      title: {{ variant.title | json }},
      options: {{ variant.options | json }},
      option1: {{ variant.option1 | json }},
      option2: {{ variant.option2 | json }},
      option3: {{ variant.option3 | json }},
      price: {{ variant.price | json }},
      available: {{ variant.available | json }},
      inventory_quantity: {{ variant.inventory_quantity | json }},

      preorder_limit: {{ variant.metafields.custom.preorder_limit.value | default: 0 | json }},
      preorder_limit2: {{ variant.metafields.custom.preorder_limit_2.value | default: 0 | json }},

      preorder_dispatch_date: {{ variant.metafields.custom.preorder_dispatch_date.value | default: "" | json }},
      preorder_dispatch_date2: {{ variant.metafields.custom.preorder_dispatch_date2.value | default: "" | json }}
    }{% unless forloop.last %},{% endunless %}
  {% endfor %}
];



    const metaEl = document.getElementById('product-meta');
    const collections = metaEl?.dataset.collections?.split(',') || [];

    var productTags = {{ product.tags | json }};
    const FORCE_ADD_TO_BASKET_TAG = "force-add-to-basket";
    const normalizedProductTags = Array.isArray(productTags)
      ? productTags.map((tag) => String(tag).toLowerCase())
      : [];
    const forceAddToBasketText = normalizedProductTags.includes(FORCE_ADD_TO_BASKET_TAG);
    const currentProductId = Number({{ product.id | json }});
    const FORCE_ADD_TO_BASKET_PRODUCT_IDS = [9997946585354, 9999211168010];
    const forceAddToBasketByProductId = FORCE_ADD_TO_BASKET_PRODUCT_IDS.includes(currentProductId);
    const LETTER_CONTROLLED_PREORDER_PRODUCT_IDS = [
      10498030633226, // The I.D. Modular Charm Necklace Silver
      10498031583498, // The I.D. Modular Charm Necklace Gold
      10506235838730, // The I.D. Charm Bracelet Silver
      10506235674890  // The I.D. Charm Bracelet Gold
    ];
    const ANYWEAR_SELECTOR_PRODUCT_IDS = [10492554805514, 10492554838282];
    const isLetterControlledPreorderProduct = LETTER_CONTROLLED_PREORDER_PRODUCT_IDS.includes(currentProductId);
    const isAnywearSelectorProductLocal = ANYWEAR_SELECTOR_PRODUCT_IDS.includes(currentProductId);
    const CHAIN_SOURCE_SELECTOR_PRODUCT_IDS = [10515901710602, 10515902169354];
    const isChainSourceSelectorProductLocal = CHAIN_SOURCE_SELECTOR_PRODUCT_IDS.includes(currentProductId);
    function updateButtonText() {
      const variantId = parseInt(variantInput.value);
      const selectedVariant = variants.find(v => v.id === variantId);

      if (!selectedVariant || !addToCartButton) return;

      const inv = selectedVariant.inventory_quantity;
      const hasTrackedInventory = inv !== null && inv !== undefined && Number.isFinite(Number(inv));
      const invNum = hasTrackedInventory ? Number(inv) : null;

      {% comment %} if (inv > 0) {
                  dynamicPreOrderText.innerText = "";
                  addToCartButton.innerText = "Add to basket";
              }
              else {
                  dynamicPreOrderText.innerText = "";
                  addToCartButton.innerText = "Out Of Stock";
                  addToCartButton.disabled = true;
              } {% endcomment %}

      const preorderLimit =  selectedVariant.preorder_limit; // Get the preorder limit for the variant
      const preorderLimit2 = selectedVariant.preorder_limit2; // Second preorder limit for the variant
      const preorderedQuantity = invNum ?? 0;  // fallback for untracked inventory
      const selectedVariantDispatchDate = selectedVariant.preorder_dispatch_date
      const selectedVariantDispatchDate2 = selectedVariant.preorder_dispatch_date2
      const selectedLetterValue = ((document.getElementById('LetterCharmSelection')?.value) || 'NO LETTER').toString().trim().toUpperCase();
      const isNoLetterSelection = selectedLetterValue === 'NO LETTER';
      const shouldHidePreorderMessage = isLetterControlledPreorderProduct ? isNoLetterSelection : forceAddToBasketText;
      const shouldUseAddToBasketLabel = forceAddToBasketByProductId || shouldHidePreorderMessage;



      if (productTags && productTags.includes("custom-pre-order")) {
        if (!hasTrackedInventory && (isAnywearSelectorProductLocal || isChainSourceSelectorProductLocal)) {
          const dispatchText = selectedVariantDispatchDate && selectedVariantDispatchDate !== ""
            ? `${selectedVariantDispatchDate}`
            : ``;
          dynamicPreOrderText.innerText = dispatchText;
          addToCartButton.innerText = shouldUseAddToBasketLabel ? "Add to Basket" : "Pre Order";
          addToCartButton.disabled = false;
          if (notifyButton) notifyButton.classList.add('hidden');
          return;
        }
        
        const remainingPreorders = preorderLimit + preorderedQuantity;  // Remaining preorders
        const remainingPreorders2 = preorderLimit2 + preorderedQuantity;  // Remaining preorders for the second limit
        const productMetaEl = document.getElementById("ProductPreorderMeta");
        const preorderDispatchDate = productMetaEl?.dataset?.dispatchDate || "";





        if (preorderedQuantity > 0) {
          dynamicPreOrderText.innerText = "";
          addToCartButton.innerText = "Add to Basket";
          addToCartButton.disabled = false;
          if (notifyButton) notifyButton.classList.add('hidden');
        }
        else if (!hasTrackedInventory && selectedVariant.available) {
          const dispatchText = shouldHidePreorderMessage
            ? ""
            : (selectedVariantDispatchDate && selectedVariantDispatchDate !== ""
            ? `${selectedVariantDispatchDate}`
            : ``);
          dynamicPreOrderText.innerText = dispatchText;
          addToCartButton.innerText = shouldUseAddToBasketLabel ? "Add to Basket" : "Pre Order";
          addToCartButton.disabled = false;
          if (notifyButton) notifyButton.classList.add('hidden');
        }
        else if (remainingPreorders > 0) {
          
          //product level
          {% comment %} const dispatchText = preorderDispatchDate && preorderDispatchDate !== "" 
  ? `${preorderDispatchDate}` 
  : `DISPATCHED ON 9TH DEC`; {% endcomment %}


          //variant level 

          const dispatchText = shouldHidePreorderMessage
          ? ``
          : (selectedVariantDispatchDate && selectedVariantDispatchDate !== ""
          ? `${selectedVariantDispatchDate}`
          : ``);
          
          

          

          {% comment %} dynamicPreOrderText.innerText = `DISPATCHED BY 11TH NOV. ${remainingPreorders} slots left.`; {% endcomment %}
          dynamicPreOrderText.innerText = dispatchText;
          addToCartButton.innerText = shouldUseAddToBasketLabel ? "Add to Basket" : "Pre Order";
          addToCartButton.disabled = false;
          if (notifyButton) notifyButton.classList.add('hidden');
        } else if (remainingPreorders2 > 0) {
          const dispatchText = shouldHidePreorderMessage
          ? ``
          : (selectedVariantDispatchDate2 && selectedVariantDispatchDate2 !== ""
          ? `${selectedVariantDispatchDate2}`
          : ``);
          dynamicPreOrderText.innerText = dispatchText;
          addToCartButton.innerText = shouldUseAddToBasketLabel ? "Add to Basket" : "Pre Order 2";
          addToCartButton.disabled = false;
          if (notifyButton) notifyButton.classList.add('hidden');
        } else {
          dynamicPreOrderText.innerText = "";
          addToCartButton.innerText = shouldUseAddToBasketLabel ? "Out of Stock" : "Pre Order (Limit Reached)";
          addToCartButton.disabled = true;
          notifyButton.classList.remove('hidden');          
        }
      } else if (isAnywearSelectorProductLocal || isChainSourceSelectorProductLocal) {
        dynamicPreOrderText.innerText = "";
        addToCartButton.innerText = "Add to Basket";
        addToCartButton.disabled = false;
        if (notifyButton) notifyButton.classList.add('hidden');
      } else if (window.__phIsChainSource) {
        // Chain source product: stock lives in the source product (base chain) and the letter pendant,
        // not in this product's own variants.
        dynamicPreOrderText.innerText = "";
        const chainCache = window.__phChainSourceCache;

        // Resolve selected size key from current variant options
        const variantOpts = [selectedVariant?.option1, selectedVariant?.option2, selectedVariant?.option3]
          .filter(Boolean)
          .map((o) => String(o).trim().toUpperCase());
        const selectedSizeKey = ['SMALL', 'MEDIUM', 'LARGE', 'ONE SIZE ONLY'].find((s) => variantOpts.includes(s)) || '';

        function applyChainSourceButtonState() {
          if (isNoLetterSelection) {
            // Check base chain (source product) availability for this size
            const sizeAvail = window.__phChainSourceCache?.availBySize?.[selectedSizeKey];
            if (sizeAvail !== undefined) {
              if (sizeAvail.available) {
                addToCartButton.innerText = "Add to Basket";
                addToCartButton.disabled = false;
                if (notifyButton) notifyButton.classList.add('hidden');
              } else {
                addToCartButton.innerText = "Out of Stock";
                addToCartButton.disabled = true;
                if (notifyButton) notifyButton.classList.remove('hidden');
              }
            } else {
              // Cache not ready — default to available, re-run when loaded
              addToCartButton.innerText = "Add to Basket";
              addToCartButton.disabled = false;
              if (notifyButton) notifyButton.classList.add('hidden');
            }
          } else {
            // Check letter pendant availability for the selected letter
            const lpAvail = window.letterPendantAvailability;
            if (lpAvail !== null && lpAvail !== undefined) {
              const letterAvailable = lpAvail[selectedLetterValue];
              if (letterAvailable === false) {
                addToCartButton.innerText = "Out of Stock";
                addToCartButton.disabled = true;
                if (notifyButton) notifyButton.classList.remove('hidden');
              } else {
                addToCartButton.innerText = "Add to Basket";
                addToCartButton.disabled = false;
                if (notifyButton) notifyButton.classList.add('hidden');
              }
            } else {
              // No availability data — default to available
              addToCartButton.innerText = "Add to Basket";
              addToCartButton.disabled = false;
              if (notifyButton) notifyButton.classList.add('hidden');
            }
          }
        }

        if (chainCache?.loaded) {
          applyChainSourceButtonState();
        } else {
          // Cache not loaded yet — show Add to Basket and re-run after cache loads
          addToCartButton.innerText = "Add to Basket";
          addToCartButton.disabled = false;
          if (notifyButton) notifyButton.classList.add('hidden');
          if (!window.__phChainSourceCacheListeners) window.__phChainSourceCacheListeners = [];
          window.__phChainSourceCacheListeners.push(applyChainSourceButtonState);
        }
      } else {
        if (inv === null || inv === undefined || inv > 0) {
          dynamicPreOrderText.innerText = "";
          addToCartButton.innerText = "Add to Basket";
          addToCartButton.disabled = false;
          addToCartButton.classList.remove('hidden');
          if (notifyButton) notifyButton.classList.add('hidden');
        } else {
          dynamicPreOrderText.innerText = "";
          addToCartButton.innerText = "Out of Stock";
          addToCartButton.disabled = true;
          addToCartButton.classList.add('hidden');
          if (notifyButton) notifyButton.classList.remove('hidden');

        }
      }        

    }

    updateButtonText();

    if (variantInput) {
      const observer = new MutationObserver(updateButtonText);
      observer.observe(variantInput, {
        attributes: true,
        attributeFilter: ['value']
      });

      variantInput.addEventListener('change', updateButtonText);
    }

    const rerunButtonState = () => {
      requestAnimationFrame(() => {
        setTimeout(updateButtonText, 0);
      });
    };

    const stickyLetterSelectEl = document.getElementById('phStickyLetterCharmSelect');
    stickyLetterSelectEl?.addEventListener('change', rerunButtonState);

    const letterHiddenInput = document.getElementById('LetterCharmSelection');
    letterHiddenInput?.addEventListener('change', rerunButtonState);

    document.querySelectorAll('[data-letter-charms-value], [data-letter-charms-pick]').forEach((el) => {
      el.addEventListener('click', rerunButtonState);
    });

    setTimeout(updateButtonText, 120);
  });
</script>

