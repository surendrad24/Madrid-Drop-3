  function updateVariantSelection(changedOptionIndex = null, changedValue = null) {
  const optionCount = Array.isArray(variants?.[0]?.options) ? variants[0].options.length : 0;
  const selectedOptions = [];

  for (let index = 0; index < optionCount; index += 1) {
    selectedOptions[index] = getOptionInputValue(index);
  }

  if (changedOptionIndex !== null && changedOptionIndex !== undefined) {
    selectedOptions[changedOptionIndex] = changedValue;
  }

  let selectedVariant = variants.find((variant) => {
    return variant.options.every((option, index) => option === selectedOptions[index]);
  });

  if (!selectedVariant && changedOptionIndex !== null && changedOptionIndex !== undefined) {
    const currentVariantId = Number(document.querySelector('input[name="id"]')?.value);
    const currentVariant = variants.find((variant) => Number(variant.id) === currentVariantId);
    const desiredOptions = Array.isArray(currentVariant?.options) ? [...currentVariant.options] : [...selectedOptions];
    desiredOptions[changedOptionIndex] = changedValue;

    selectedVariant = variants.find((variant) => {
      return variant.options.every((option, index) => option === desiredOptions[index]);
    });
  }

  // For letter-charm products the letter option has no Option<n> input in the DOM,
  // so the fallback above preserves the current letter (often 'A') which may be OOS.
  // If that happens, find any available variant with the desired size instead.
  if (
    letterCharmsEnabled &&
    changedOptionIndex !== null &&
    changedValue !== null &&
    selectedVariant &&
    !selectedVariant.available
  ) {
    const availableForSize = variants.find(
      (v) => v.options[changedOptionIndex] === changedValue && v.available
    );
    if (availableForSize) selectedVariant = availableForSize;
  }

    if (selectedVariant) {
      syncOptionUiFromVariant(selectedVariant);
      const variantIdInput = document.querySelector('input[name="id"]');
      if (variantIdInput) {
        variantIdInput.value = selectedVariant.id;
        variantIdInput.setAttribute('value', selectedVariant.id);
        variantIdInput.dispatchEvent(new Event('change', { bubbles: true }));
      }
    
    const priceElement = document.querySelector('[data-product-price]');
    if (priceElement) {
       var currencyCode = window.Shopify.currency.active;
        var userLocale = navigator.language || 'en-US';

         const originalEl = document.querySelector('[data-original-price]');
const discountEl = document.querySelector('[data-discount-price]');


if (originalEl && discountEl) {
